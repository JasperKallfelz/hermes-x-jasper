@@ -0,0 +1,127 @@
+"""Opt-in auto-launch for configured loopback CDP endpoints."""
+
+from unittest.mock import patch
+
+
+LOCAL_URL = "http://127.0.0.1:9222"
+REMOTE_URL = "http://198.51.100.7:9222"
+RESOLVED_WS = "ws://127.0.0.1:9222/devtools/browser/example"
+
+
+def test_config_controls_auto_cdp(monkeypatch):
+    from tools.browser_tool import _auto_launch_local_cdp_enabled
+
+    monkeypatch.delenv("BROWSER_TOOL_AUTO_CDP", raising=False)
+    with patch(
+        "hermes_cli.config.read_raw_config",
+        return_value={"browser": {"auto_launch_local_cdp": True}},
+    ):
+        assert _auto_launch_local_cdp_enabled() is True
+    with patch(
+        "hermes_cli.config.read_raw_config",
+        return_value={"browser": {"auto_launch_local_cdp": False}},
+    ):
+        assert _auto_launch_local_cdp_enabled() is False
+
+
+def test_explicit_environment_override_has_precedence(monkeypatch):
+    from tools.browser_tool import _auto_launch_local_cdp_enabled
+
+    with patch(
+        "hermes_cli.config.read_raw_config",
+        return_value={"browser": {"auto_launch_local_cdp": True}},
+    ) as read_config:
+        monkeypatch.setenv("BROWSER_TOOL_AUTO_CDP", "0")
+        assert _auto_launch_local_cdp_enabled() is False
+        monkeypatch.setenv("BROWSER_TOOL_AUTO_CDP", "1")
+        assert _auto_launch_local_cdp_enabled() is True
+    read_config.assert_not_called()
+
+
+def test_remote_endpoint_never_triggers_local_launch(monkeypatch):
+    from tools.browser_tool import _ensure_local_cdp_ready
+
+    monkeypatch.setenv("BROWSER_TOOL_AUTO_CDP", "1")
+    with patch("hermes_cli.browser_connect.try_launch_chrome_debug") as launch:
+        assert _ensure_local_cdp_ready(REMOTE_URL) == REMOTE_URL
+    launch.assert_not_called()
+
+
+def test_reachable_loopback_endpoint_is_left_alone(monkeypatch):
+    from tools.browser_tool import _ensure_local_cdp_ready
+
+    monkeypatch.setenv("BROWSER_TOOL_AUTO_CDP", "1")
+    with patch(
+        "hermes_cli.browser_connect.is_browser_debug_ready", return_value=True
+    ), patch("hermes_cli.browser_connect.try_launch_chrome_debug") as launch:
+        assert _ensure_local_cdp_ready(LOCAL_URL) == LOCAL_URL
+    launch.assert_not_called()
+
+
+def test_missing_loopback_endpoint_launches_waits_and_resolves(monkeypatch):
+    from tools.browser_tool import _ensure_local_cdp_ready
+
+    monkeypatch.setenv("BROWSER_TOOL_AUTO_CDP", "1")
+    with patch(
+        "hermes_cli.browser_connect.is_browser_debug_ready",
+        side_effect=[False, True],
+    ), patch(
+        "hermes_cli.browser_connect.try_launch_chrome_debug", return_value=True
+    ) as launch, patch(
+        "tools.browser_tool._resolve_cdp_override", return_value=RESOLVED_WS
+    ) as resolve:
+        assert _ensure_local_cdp_ready(LOCAL_URL) == RESOLVED_WS
+
+    launch.assert_called_once_with(9222)
+    resolve.assert_called_once_with(LOCAL_URL)
+
+
+def test_failed_launch_returns_original_endpoint(monkeypatch):
+    from tools.browser_tool import _ensure_local_cdp_ready
+
+    monkeypatch.setenv("BROWSER_TOOL_AUTO_CDP", "1")
+    with patch(
+        "hermes_cli.browser_connect.is_browser_debug_ready", return_value=False
+    ), patch(
+        "hermes_cli.browser_connect.try_launch_chrome_debug", return_value=False
+    ):
+        assert _ensure_local_cdp_ready(LOCAL_URL) == LOCAL_URL
+
+
+def test_session_creation_auto_launches_before_endpoint_resolution(monkeypatch):
+    import tools.browser_tool as browser
+
+    task_id = "test-auto-cdp-wiring"
+    calls = {}
+    monkeypatch.setattr(browser, "_start_browser_cleanup_thread", lambda: None)
+    monkeypatch.setattr(browser, "_update_session_activity", lambda _task: None)
+    monkeypatch.setattr(browser, "_ensure_cdp_supervisor", lambda _task: None)
+    monkeypatch.setattr(browser, "_get_cdp_override_raw", lambda: LOCAL_URL)
+
+    def ensure(url):
+        calls["ensured"] = url
+        return RESOLVED_WS
+
+    def resolve(url):
+        calls["resolved"] = url
+        return url
+
+    def create(tid, url):
+        calls["created"] = url
+        return {"session_id": tid, "cdp_url": url, "provider": "cdp"}
+
+    monkeypatch.setattr(browser, "_ensure_local_cdp_ready", ensure)
+    monkeypatch.setattr(browser, "_resolve_cdp_override", resolve)
+    monkeypatch.setattr(browser, "_create_cdp_session", create)
+
+    try:
+        info = browser._get_session_info(task_id)
+    finally:
+        browser._active_sessions.pop(task_id, None)
+
+    assert calls == {
+        "ensured": LOCAL_URL,
+        "resolved": RESOLVED_WS,
+        "created": RESOLVED_WS,
+    }
+    assert info["cdp_url"] == RESOLVED_WS
