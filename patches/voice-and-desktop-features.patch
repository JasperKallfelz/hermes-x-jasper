@@ -0,0 +1,42 @@
+"""The Hermes-managed debug Chrome must expose DevTools on loopback only.
+
+Without ``--remote-debugging-address=127.0.0.1`` Chrome may bind the remote
+debugging socket more broadly, exposing an unauthenticated CDP endpoint to the
+local network. Every launch path (direct spawn and the copy-paste manual
+commands) must pin the listener to the IPv4 loopback.
+"""
+
+from unittest.mock import patch
+
+
+def test_debug_launch_args_pin_devtools_to_loopback():
+    from hermes_cli.browser_connect import _chrome_debug_args
+
+    args = _chrome_debug_args(9222)
+    assert "--remote-debugging-address=127.0.0.1" in args
+    assert "--remote-debugging-port=9222" in args
+
+
+def test_manual_command_with_detected_binary_pins_loopback():
+    from hermes_cli.browser_connect import manual_chrome_debug_command
+
+    with patch(
+        "hermes_cli.browser_connect.get_chrome_debug_candidates",
+        return_value=["/usr/bin/chromium"],
+    ):
+        cmd = manual_chrome_debug_command(9222, system="Linux")
+
+    assert cmd is not None
+    assert "--remote-debugging-address=127.0.0.1" in cmd
+
+
+def test_manual_command_darwin_open_fallback_pins_loopback():
+    from hermes_cli.browser_connect import manual_chrome_debug_command
+
+    with patch(
+        "hermes_cli.browser_connect.get_chrome_debug_candidates", return_value=[]
+    ):
+        cmd = manual_chrome_debug_command(9222, system="Darwin")
+
+    assert cmd is not None
+    assert "--remote-debugging-address=127.0.0.1" in cmd
diff --git a/tests/tools/test_browser_auto_cdp.py b/tests/tools/test_browser_auto_cdp.py
new file mode 100644
index 0000000000000000000000000000000000000000..e24f52b1b9ff592941a9b1cb6487e0caabc27916
--- /dev/null
+++ b/tests/tools/test_browser_auto_cdp.py
@@ -0,0 +1,113 @@
+"""Opt-in auto-launch of a local debug Chrome for loopback ``cdp_url`` endpoints.
+
+When ``BROWSER_TOOL_AUTO_CDP`` is truthy and the configured CDP override points
+at a loopback DevTools endpoint that is not yet listening, the browser tool
+launches the Hermes-managed debug Chrome on demand instead of failing the
+connection. Remote/cloud endpoints are never auto-launched, and the feature is
+fully inert unless explicitly enabled.
+"""
+
+from unittest.mock import patch
+
+LOCAL_URL = "http://127.0.0.1:9222"
+REMOTE_URL = "http://198.51.100.7:9222"
+RESOLVED_WS = "ws://127.0.0.1:9222/devtools/browser/abc123"
+
+
+def test_disabled_by_default_is_a_noop(monkeypatch):
+    """Without the env opt-in nothing is probed or launched."""
+    from tools.browser_tool import _ensure_local_cdp_ready
+
+    monkeypatch.delenv("BROWSER_TOOL_AUTO_CDP", raising=False)
+    with patch("hermes_cli.browser_connect.try_launch_chrome_debug") as mock_launch, \
+            patch("hermes_cli.browser_connect.is_browser_debug_ready") as mock_ready:
+        assert _ensure_local_cdp_ready(LOCAL_URL) == LOCAL_URL
+
+    mock_launch.assert_not_called()
+    mock_ready.assert_not_called()
+
+
+def test_enabled_never_launches_for_non_loopback_endpoint(monkeypatch):
+    """Cloud/remote CDP endpoints must never trigger a local browser launch."""
+    from tools.browser_tool import _ensure_local_cdp_ready
+
+    monkeypatch.setenv("BROWSER_TOOL_AUTO_CDP", "1")
+    with patch("hermes_cli.browser_connect.try_launch_chrome_debug") as mock_launch:
+        assert _ensure_local_cdp_ready(REMOTE_URL) == REMOTE_URL
+
+    mock_launch.assert_not_called()
+
+
+def test_enabled_already_listening_endpoint_is_left_alone(monkeypatch):
+    from tools.browser_tool import _ensure_local_cdp_ready
+
+    monkeypatch.setenv("BROWSER_TOOL_AUTO_CDP", "1")
+    with patch("hermes_cli.browser_connect.is_browser_debug_ready", return_value=True), \
+            patch("hermes_cli.browser_connect.try_launch_chrome_debug") as mock_launch:
+        assert _ensure_local_cdp_ready(LOCAL_URL) == LOCAL_URL
+
+    mock_launch.assert_not_called()
+
+
+def test_enabled_launches_waits_and_reresolves(monkeypatch):
+    """Loopback endpoint down -> launch debug Chrome on that port, wait until
+    the port answers, then return a freshly resolved websocket endpoint."""
+    from tools.browser_tool import _ensure_local_cdp_ready
+
+    monkeypatch.setenv("BROWSER_TOOL_AUTO_CDP", "1")
+    # First probe: endpoint down. Second probe (post-launch poll): up.
+    with patch(
+        "hermes_cli.browser_connect.is_browser_debug_ready",
+        side_effect=[False, True],
+    ), patch(
+        "hermes_cli.browser_connect.try_launch_chrome_debug", return_value=True
+    ) as mock_launch, patch(
+        "tools.browser_tool._resolve_cdp_override", return_value=RESOLVED_WS
+    ) as mock_resolve:
+        assert _ensure_local_cdp_ready(LOCAL_URL) == RESOLVED_WS
+
+    mock_launch.assert_called_once_with(9222)
+    mock_resolve.assert_called_once_with(LOCAL_URL)
+
+
+def test_failed_launch_returns_original_url(monkeypatch):
+    """A failed launch surfaces the caller's normal connection error path."""
+    from tools.browser_tool import _ensure_local_cdp_ready
+
+    monkeypatch.setenv("BROWSER_TOOL_AUTO_CDP", "1")
+    with patch("hermes_cli.browser_connect.is_browser_debug_ready", return_value=False), \
+            patch("hermes_cli.browser_connect.try_launch_chrome_debug", return_value=False):
+        assert _ensure_local_cdp_ready(LOCAL_URL) == LOCAL_URL
+
+
+def test_get_session_info_runs_auto_launch_on_the_cdp_override_path(monkeypatch):
+    """The CDP-override session path passes the override through the
+    auto-launch hook and connects to whatever endpoint it returns."""
+    import tools.browser_tool as bt
+
+    task_id = "test-auto-cdp-wiring"
+    calls = {}
+
+    monkeypatch.setattr(bt, "_start_browser_cleanup_thread", lambda: None)
+    monkeypatch.setattr(bt, "_update_session_activity", lambda tid: None)
+    monkeypatch.setattr(bt, "_get_cdp_override", lambda: LOCAL_URL)
+
+    def fake_ensure(url):
+        calls["ensured"] = url
+        return RESOLVED_WS
+
+    def fake_create(tid, url):
+        calls["created"] = url
+        return {"session_id": tid, "cdp_url": url, "provider": "cdp"}
+
+    monkeypatch.setattr(bt, "_ensure_local_cdp_ready", fake_ensure)
+    monkeypatch.setattr(bt, "_create_cdp_session", fake_create)
+
+    try:
+        info = bt._get_session_info(task_id)
+    finally:
+        bt._active_sessions.pop(task_id, None)
+
+    assert calls["ensured"] == LOCAL_URL
+    assert calls["created"] == RESOLVED_WS
+    assert info["cdp_url"] == RESOLVED_WS
diff --git a/tests/tools/test_tts_runtime_overrides.py b/tests/tools/test_tts_runtime_overrides.py
