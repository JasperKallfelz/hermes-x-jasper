diff --git a/tests/gateway/test_telegram_location_keyboard_cleanup.py b/tests/gateway/test_telegram_location_keyboard_cleanup.py
new file mode 100644
index 0000000000000000000000000000000000000000..9334805d6b7a782e4d630b312fc9153f27634a87
--- /dev/null
+++ b/tests/gateway/test_telegram_location_keyboard_cleanup.py
@@ -0,0 +1,201 @@
+"""Telegram reply-keyboard cleanup after a location share.
+
+Telegram request-location buttons are *reply keyboards*: they stay pinned at
+the bottom of the client until the bot sends a ``ReplyKeyboardRemove``. Once a
+location/venue update arrives the coordinates are already in hand, so the
+adapter must clear that stale keyboard immediately (via a short-lived control
+message) instead of leaving the "share location" button stuck on screen while
+the agent is still thinking.
+"""
+
+import asyncio
+import sys
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, MagicMock
+
+from gateway.config import PlatformConfig
+
+
+def _ensure_telegram_mock():
+    if "telegram" in sys.modules and hasattr(sys.modules["telegram"], "__file__"):
+        return
+
+    telegram_mod = MagicMock()
+    telegram_mod.ext.ContextTypes.DEFAULT_TYPE = type(None)
+    telegram_mod.constants.ParseMode.MARKDOWN_V2 = "MarkdownV2"
+    telegram_mod.constants.ChatType.GROUP = "group"
+    telegram_mod.constants.ChatType.SUPERGROUP = "supergroup"
+    telegram_mod.constants.ChatType.CHANNEL = "channel"
+    telegram_mod.constants.ChatType.PRIVATE = "private"
+
+    for name in ("telegram", "telegram.ext", "telegram.constants", "telegram.request"):
+        sys.modules.setdefault(name, telegram_mod)
+
+
+_ensure_telegram_mock()
+
+from plugins.platforms.telegram.adapter import TelegramAdapter  # noqa: E402
+
+
+def _make_adapter():
+    return TelegramAdapter(PlatformConfig(enabled=True, token="***", extra={}))
+
+
+def _make_bot(send_side_effect=None):
+    bot = MagicMock()
+    sent = SimpleNamespace(message_id=555)
+    bot.send_message = AsyncMock(return_value=sent, side_effect=send_side_effect)
+    bot.delete_message = AsyncMock()
+    return bot, sent
+
+
+def _assert_is_keyboard_remove(reply_markup):
+    import telegram
+
+    rkr = telegram.ReplyKeyboardRemove
+    if isinstance(rkr, type):
+        assert isinstance(reply_markup, rkr)
+    else:  # mocked telegram module
+        assert reply_markup is rkr.return_value
+
+
+def _run_and_drain(coro):
+    """Run ``coro`` and any fire-and-forget tasks it scheduled."""
+
+    async def runner():
+        await coro
+        pending = [t for t in asyncio.all_tasks() if t is not asyncio.current_task()]
+        if pending:
+            await asyncio.gather(*pending)
+
+    asyncio.run(runner())
+
+
+def test_location_share_sends_reply_keyboard_remove():
+    adapter = _make_adapter()
+    bot, _ = _make_bot()
+    adapter._bot = bot
+    msg = SimpleNamespace(chat_id=111, message_thread_id=None)
+
+    _run_and_drain(adapter._remove_location_request_keyboard(msg))
+
+    kwargs = bot.send_message.await_args.kwargs
+    assert kwargs["chat_id"] == 111
+    assert kwargs["text"]  # keyboard removal needs a carrier message
+    _assert_is_keyboard_remove(kwargs["reply_markup"])
+
+
+def test_control_notice_is_deleted_after_the_keyboard_is_cleared(monkeypatch):
+    """The carrier message is transient: it gets deleted shortly after."""
+    adapter = _make_adapter()
+    bot, sent = _make_bot()
+    adapter._bot = bot
+    msg = SimpleNamespace(chat_id=111, message_thread_id=None)
+
+    async def instant_sleep(_delay):
+        return None
+
+    monkeypatch.setattr(asyncio, "sleep", instant_sleep)
+    _run_and_drain(adapter._remove_location_request_keyboard(msg))
+
+    bot.delete_message.assert_awaited_once_with(
+        chat_id=111, message_id=sent.message_id
+    )
+
+
+def test_thread_scoped_send_failure_retries_without_thread_id():
+    """Some forum/private-topic sends reject ``message_thread_id`` for control
+    messages; keyboard removal is chat-scoped, so retry once without it."""
+    adapter = _make_adapter()
+    bot, sent = _make_bot()
+    bot.send_message.side_effect = [RuntimeError("Bad Request: thread not found"), sent]
+    adapter._bot = bot
+    msg = SimpleNamespace(chat_id=111, message_thread_id=7)
+
+    _run_and_drain(adapter._remove_location_request_keyboard(msg))
+
+    first, second = bot.send_message.await_args_list
+    assert first.kwargs["message_thread_id"] == 7
+    assert "message_thread_id" not in second.kwargs
+    _assert_is_keyboard_remove(second.kwargs["reply_markup"])
+
+
+def test_missing_bot_or_chat_id_is_a_silent_noop():
+    adapter = _make_adapter()
+    adapter._bot = None
+    _run_and_drain(
+        adapter._remove_location_request_keyboard(SimpleNamespace(chat_id=111))
+    )
+
+    bot, _ = _make_bot()
+    adapter._bot = bot
+    _run_and_drain(
+        adapter._remove_location_request_keyboard(SimpleNamespace(chat_id=None))
+    )
+    bot.send_message.assert_not_awaited()
+
+
+def _location_update(msg):
+    return SimpleNamespace(effective_message=msg, message=msg, update_id=1)
+
+
+def _wire_location_flow(adapter, monkeypatch):
+    """Stub authorization and downstream dispatch; record cleanup calls."""
+    cleaned = []
+    handled = []
+
+    monkeypatch.setattr(
+        adapter, "_is_user_authorized_from_message", lambda m: True
+    )
+    monkeypatch.setattr(adapter, "_should_process_message", lambda m: True)
+
+    async def record_cleanup(m):
+        cleaned.append(m)
+
+    monkeypatch.setattr(
+        adapter, "_remove_location_request_keyboard", record_cleanup
+    )
+
+    event = SimpleNamespace(text="")
+    monkeypatch.setattr(
+        adapter, "_build_message_event", lambda *a, **k: event
+    )
+    monkeypatch.setattr(
+        adapter, "_apply_telegram_group_observe_attribution", lambda e: e
+    )
+
+    async def record_handle(e):
+        handled.append(e)
+
+    monkeypatch.setattr(adapter, "handle_message", record_handle)
+    return cleaned, handled
+
+
+def test_location_message_triggers_keyboard_cleanup_and_dispatch(monkeypatch):
+    adapter = _make_adapter()
+    cleaned, handled = _wire_location_flow(adapter, monkeypatch)
+    msg = SimpleNamespace(
+        chat_id=111,
+        message_thread_id=None,
+        venue=None,
+        location=SimpleNamespace(latitude=52.52, longitude=13.405),
+    )
+
+    asyncio.run(adapter._handle_location_message(_location_update(msg), None))
+
+    assert cleaned == [msg]
+    assert len(handled) == 1
+    assert "52.52" in handled[0].text
+
+
+def test_update_without_location_never_touches_the_keyboard(monkeypatch):
+    adapter = _make_adapter()
+    cleaned, handled = _wire_location_flow(adapter, monkeypatch)
+    msg = SimpleNamespace(
+        chat_id=111, message_thread_id=None, venue=None, location=None
+    )
+
+    asyncio.run(adapter._handle_location_message(_location_update(msg), None))
+
+    assert cleaned == []
+    assert handled == []
