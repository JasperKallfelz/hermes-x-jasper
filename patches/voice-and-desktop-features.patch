+_TASK_TERMS = (
+    # German intent verbs
+    "bau", "baue", "bauen", "mach", "mache", "erstell", "erstelle",
+    "implementier", "implementiere", "programmier", "programmiere",
+    "entwickel", "entwickle", "schreib", "schreibe", "fix", "reparier",
+    "teste", "check", "prüf", "pruef", "debug", "debugge",
+    "verifizier", "verifiziere", "analysier", "analysiere", "untersuch",
+    "untersuche", "recherchier", "recherchiere", "selbsttest", "ausführen",
+    "ausfuehren", "ausgeführt",
+    "ausgefuehrt",
+    # English intent verbs
+    "build", "create", "make", "implement", "code", "write", "fix", "develop", "research",
+)
+_TASK_OBJECT_TERMS = (
+    "app", "website", "webseite", "seite", "tool", "script", "skript", "code",
+    "feature", "funktion", "komponente", "prototype", "prototyp", "preview",
+    "demo", "dashboard", "landing", "page", "api", "service", "debug", "test",
+    "selbsttest", "selftest", "qa", "background", "agent", "agents",
+    "mail", "email", "e-mail", "inbox", "postfach", "calendar", "kalender",
+    "termin", "meeting", "research", "recherche", "browser", "workflow",
+    "automation", "automatisierung", "erinnerung", "reminder", "llm", "modell", "model",
+)
+_DELIVERY_TERMS = (
+    "schick", "schicke", "sende", "send", "tag", "tagg", "preview", "link",
+    "aufs handy", "telegram", "discord", "zeig", "zeige",
+)
+_STATUS_TERMS = (
+    "status", "stand", "was läuft", "woran arbeitest", "what's running",
+    "what is running", "jobs", "tasks", "aufgaben",
+)
+_GREETING_TERMS = (
+    "hallo", "hello", "hey", "hi", "servus", "moin", "hörst du mich",
+    "hoerst du mich", "can you hear me", "are you there",
+)
+_BACKCHANNEL_TERMS = {
+    "mhm", "hm", "mm", "mmh", "mm-hmm", "uh", "uh-huh", "äh", "ah",
+}
+
+VOICE_WORKER_KINDS = (
+    "coding", "mail", "calendar", "research", "browser", "personal", "automation",
+)
