+def test_voice_job_runner_blocks_cleanly_when_codex_missing(tmp_path, monkeypatch):
+    store = VoiceJobStore(tmp_path / "voice_jobs")
+    job = store.create(prompt="bau mir eine app", source={"platform": "discord"})
+    events = []
+
+    async def notify(message, metadata):
+        events.append((message, metadata))
+
+    monkeypatch.setattr("gateway.voice_jobs.shutil.which", lambda name: None)
+    runner = VoiceJobRunner(store, notify, timeout=1, enable_external_cli=True)
+    asyncio.run(runner.run(job.id))
+
+    loaded = store.load(job.id)
+    assert loaded.status == "needs_input"
+    assert "No voice worker" in loaded.error
+    assert any("blockiert" in message for message, _metadata in events)
