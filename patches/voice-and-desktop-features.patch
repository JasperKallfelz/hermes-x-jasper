@@ -0,0 +1,166 @@
+"""Behavioral tests for persistent/incremental Discord Parakeet STT."""
+
+from __future__ import annotations
+
+import time
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, MagicMock, patch
+
+import pytest
+
+from plugins.platforms.discord.streaming_stt import PersistentParakeetSTT
+
+
+class _FakeStream:
+    def __init__(self):
+        self.chunks = []
+
+    def add_audio(self, audio):
+        self.chunks.append(audio)
+
+    @property
+    def result(self):
+        return SimpleNamespace(text=" ".join(str(chunk) for chunk in self.chunks))
+
+
+class _FakeModel:
+    def __init__(self):
+        self.created = 0
+
+    def transcribe_stream(self, **_kwargs):
+        self.created += 1
+        return _FakeStream()
+
+
+class _TestWorker(PersistentParakeetSTT):
+    def _pcm_to_16k_mono(self, pcm, sample_rate, channels):
+        del sample_rate, channels
+        if not pcm:
+            raise ValueError("empty")
+        return pcm.decode()
+
+
+def _loaded_worker():
+    worker = _TestWorker(min_chunk_ms=0)
+    worker._model = _FakeModel()
+    worker._unavailable_reason = ""
+    return worker
+
+
+def test_persistent_worker_reuses_model_and_isolates_speakers():
+    worker = _loaded_worker()
+
+    assert worker.feed_pcm((1, 10), b"eins") == "eins"
+    assert worker.feed_pcm((1, 10), b"zwei") == "eins zwei"
+    assert worker.feed_pcm((1, 11), b"other") == "other"
+
+    assert worker._model.created == 2
+    assert worker.finalize((1, 10)) == "eins zwei"
+    assert worker.finalize((1, 10)) is None
+    assert worker.finalize((1, 11)) == "other"
+
+
+def test_stream_failure_resets_only_failing_speaker():
+    worker = _loaded_worker()
+    assert worker.feed_pcm((1, 10), b"ok") == "ok"
+    assert worker.feed_pcm((1, 11), b"ok") == "ok"
+
+    assert worker.feed_pcm((1, 10), b"") is None
+    assert worker.finalize((1, 10)) is None
+    assert worker.finalize((1, 11)) == "ok"
+
+
+def test_reset_conversation_does_not_cross_guilds():
+    worker = _loaded_worker()
+    worker.feed_pcm((1, 10), b"one")
+    worker.feed_pcm((2, 10), b"two")
+
+    worker.reset_conversation(1)
+
+    assert worker.finalize((1, 10)) is None
+    assert worker.finalize((2, 10)) == "two"
+
+
+def _make_receiver():
+    from plugins.platforms.discord.adapter import VoiceReceiver
+
+    vc = MagicMock()
+    vc.channel = None
+    return VoiceReceiver(vc)
+
+
+def test_receiver_drains_incrementally_without_consuming_fallback_audio():
+    receiver = _make_receiver()
+    receiver.map_ssrc(100, 42)
+    receiver._buffers[100].extend(b"first")
+
+    assert receiver.drain_stream_chunks() == [(100, 42, b"first")]
+    assert bytes(receiver._buffers[100]) == b"first"
+    assert receiver.drain_stream_chunks() == []
+
+    receiver._buffers[100].extend(b"second")
+    assert receiver.drain_stream_chunks() == [(100, 42, b"second")]
+    assert bytes(receiver._buffers[100]) == b"firstsecond"
+
+
+def test_streaming_endpoint_override_does_not_change_legacy_default():
+    receiver = _make_receiver()
+    receiver.map_ssrc(100, 42)
+    receiver._buffers[100] = bytearray(b"\x00" * 96000)
+    receiver._last_packet_time[100] = time.monotonic() - 0.5
+
+    assert receiver.check_silence() == []
+    completed = receiver.check_silence(silence_threshold=0.45)
+    assert len(completed) == 1
+    assert completed[0][0] == 42
+
+
+@pytest.mark.asyncio
+async def test_streaming_transcript_bypasses_legacy_file_stt():
+    from gateway.config import Platform, PlatformConfig
+    from plugins.platforms.discord.adapter import DiscordAdapter
+
+    adapter = object.__new__(DiscordAdapter)
+    adapter.platform = Platform.DISCORD
+    adapter.config = PlatformConfig(enabled=True, extra={})
+    adapter._voice_input_callback = AsyncMock()
+
+    with patch(
+        "plugins.platforms.discord.adapter.VoiceReceiver.pcm_to_wav",
+        side_effect=AssertionError("legacy conversion must not run"),
+    ), patch("tools.voice_mode.is_whisper_hallucination", return_value=False):
+        await adapter._process_voice_input(
+            111,
+            42,
+            b"unused",
+            transcript_override="Hallo, hörst du mich",
+            capture_end_monotonic=time.monotonic(),
+        )
+
+    adapter._voice_input_callback.assert_awaited_once_with(
+        guild_id=111,
+        user_id=42,
+        transcript="Hallo, hörst du mich",
+    )
+
+
+@pytest.mark.asyncio
+async def test_adapter_runs_all_mlx_operations_on_one_worker_thread():
+    import concurrent.futures
+    import threading
+
+    from plugins.platforms.discord.adapter import DiscordAdapter
+
+    adapter = object.__new__(DiscordAdapter)
+    adapter._streaming_stt_executor = concurrent.futures.ThreadPoolExecutor(
+        max_workers=1,
+        thread_name_prefix="test-parakeet",
+    )
+    try:
+        first = await adapter._run_streaming_stt(threading.get_ident)
+        second = await adapter._run_streaming_stt(threading.get_ident)
+    finally:
+        adapter._streaming_stt_executor.shutdown(wait=True)
+
+    assert first == second
+    assert first != threading.get_ident()
