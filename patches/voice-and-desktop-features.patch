+"""Internal per-call TTS overrides for transport speaker personas."""
+
+import json
+
+
+def test_runtime_overrides_are_provider_scoped_without_mutating_config():
+    from tools.tts_tool import _apply_runtime_tts_overrides
+
+    original = {
+        "provider": "openai",
+        "voice": "global-old",
+        "edge": {"voice": "edge-old", "speed": 1.0},
+    }
+    resolved = _apply_runtime_tts_overrides(
+        original,
+        provider="edge",
+        voice="en-US-AriaNeural",
+        model="edge-persona-model",
+        speed=1.15,
+    )
+
+    assert original == {
+        "provider": "openai",
+        "voice": "global-old",
+        "edge": {"voice": "edge-old", "speed": 1.0},
+    }
+    assert resolved["provider"] == "edge"
+    assert resolved["voice"] == "en-US-AriaNeural"
+    assert resolved["model"] == "edge-persona-model"
+    assert resolved["speed"] == 1.15
+    assert resolved["edge"] == {
+        "voice": "en-US-AriaNeural",
+        "voice_id": "en-US-AriaNeural",
+        "model": "edge-persona-model",
+        "model_id": "edge-persona-model",
+        "speed": 1.15,
+    }
+
+
+def test_named_provider_block_receives_runtime_values():
+    from tools.tts_tool import _apply_runtime_tts_overrides
+
+    original = {
+        "provider": "speaker",
+        "providers": {"speaker": {"type": "command", "voice": "old"}},
+    }
+    resolved = _apply_runtime_tts_overrides(original, voice="new")
+
+    assert original["providers"]["speaker"] == {
+        "type": "command",
+        "voice": "old",
+    }
+    assert resolved["providers"]["speaker"]["voice"] == "new"
+    assert resolved["providers"]["speaker"]["type"] == "command"
+
+
+def test_internal_overrides_reach_the_selected_generator(monkeypatch, tmp_path):
+    import tools.tts_tool as tts
+
+    captured = {}
+    output_path = tmp_path / "voice.mp3"
+    monkeypatch.setattr(
+        tts,
+        "_load_tts_config",
+        lambda: {"provider": "minimax", "openai": {"voice": "alloy"}},
+    )
+    monkeypatch.setattr(tts, "_import_openai_client", lambda: None)
+
+    def generate(_text, path, config, **_kwargs):
+        captured["config"] = config
+        with open(path, "wb") as audio:
+            audio.write(b"audio")
+        return path
+
+    monkeypatch.setattr(tts, "_generate_openai_tts", generate)
+    result = json.loads(
+        tts.text_to_speech_tool(
+            "hello",
+            output_path=str(output_path),
+            provider_override="openai",
+            voice_override="nova",
+            model_override="persona-model",
+            speed_override=1.25,
+        )
+    )
+
+    assert result["success"] is True
+    config = captured["config"]
+    assert config["provider"] == "openai"
+    assert config["openai"]["voice"] == "nova"
+    assert config["openai"]["voice_id"] == "nova"
+    assert config["openai"]["model"] == "persona-model"
+    assert config["openai"]["model_id"] == "persona-model"
+    assert config["openai"]["speed"] == 1.25
+
+
+def test_upstream_public_arguments_remain_available():
+    """v0.20.6 owns model-facing provider/speed; the patch must preserve it."""
+    from tools.tts_tool import TTS_SCHEMA
+
+    properties = TTS_SCHEMA["parameters"]["properties"]
