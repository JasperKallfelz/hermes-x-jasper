+    async def _remove_location_request_keyboard(self, msg: Any) -> None:
+        """Clear any persistent Telegram reply keyboard after a location share.
+
+        Telegram's request-location buttons are reply keyboards: they stay
+        pinned at the bottom of the client until the bot sends a
+        ReplyKeyboardRemove.  Once a location/venue update arrives the
+        coordinates are already in hand, so clear that UI immediately (via a
+        short-lived control message) instead of waiting for the agent's
+        eventual reply, which may take tool calls and otherwise leaves a stale
+        "share location" button on screen.
+        """
+        bot = self._bot
+        if not bot:
+            return
+        try:
+            from telegram import ReplyKeyboardRemove as _ReplyKeyboardRemove
+        except Exception:
+            return
+
+        chat_id = getattr(msg, "chat_id", None)
+        if chat_id is None:
+            return
+
+        kwargs: Dict[str, Any] = {
+            "chat_id": int(chat_id),
+            "text": "📍 Location received.",
+            "reply_markup": _ReplyKeyboardRemove(),
+        }
+        thread_id = getattr(msg, "message_thread_id", None)
+        if thread_id is not None:
+            kwargs["message_thread_id"] = thread_id
+
+        try:
+            sent = await bot.send_message(**kwargs)
+        except Exception as first_err:
+            # Some forum/private-topic sends reject message_thread_id for
+            # control messages.  Keyboard removal is chat-scoped, so retry
+            # once without it.
+            if "message_thread_id" not in kwargs:
+                logger.debug("[Telegram] Failed to remove location keyboard: %s", first_err)
+                return
+            kwargs.pop("message_thread_id", None)
+            try:
+                sent = await bot.send_message(**kwargs)
+            except Exception as second_err:
+                logger.debug("[Telegram] Failed to remove location keyboard: %s", second_err)
+                return
+
+        async def _delete_notice() -> None:
+            await asyncio.sleep(3)
+            try:
+                await bot.delete_message(chat_id=int(chat_id), message_id=sent.message_id)
+            except Exception:
+                pass
+
+        try:
+            asyncio.create_task(_delete_notice())
+        except Exception:
+            pass
+
