diff --git a/tests/gateway/test_telegram_location_keyboard_cleanup.py b/tests/gateway/test_telegram_location_keyboard_cleanup.py
new file mode 100644
index 0000000000000000000000000000000000000000..13c315a07615dabcde8dbe954b3beec1f29d88f0
--- /dev/null
+++ b/tests/gateway/test_telegram_location_keyboard_cleanup.py
@@ -0,0 +1,165 @@
+"""Telegram reply-keyboard cleanup after a location share."""
+
+import asyncio
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, MagicMock
+
+from gateway.config import PlatformConfig
+from plugins.platforms.telegram.adapter import TelegramAdapter
+
+
+def _make_adapter():
+    return TelegramAdapter(PlatformConfig(enabled=True, token="placeholder", extra={}))
+
+
+def _make_bot(send_side_effect=None):
+    bot = MagicMock()
+    sent = SimpleNamespace(message_id=555)
+    bot.send_message = AsyncMock(return_value=sent, side_effect=send_side_effect)
+    bot.delete_message = AsyncMock()
+    return bot, sent
+
+
+def test_location_share_sends_reply_keyboard_remove():
+    from telegram import ReplyKeyboardRemove
+
+    adapter = _make_adapter()
+    bot, _sent = _make_bot()
+    adapter._bot = bot
+    message = SimpleNamespace(chat_id=111, message_thread_id=None)
+
+    asyncio.run(adapter._remove_location_request_keyboard(message))
+
+    kwargs = bot.send_message.await_args.kwargs
+    assert kwargs["chat_id"] == 111
+    assert kwargs["text"] == "📍 Location received."
+    if isinstance(ReplyKeyboardRemove, type):
+        assert isinstance(kwargs["reply_markup"], ReplyKeyboardRemove)
+    else:
+        assert kwargs["reply_markup"] is ReplyKeyboardRemove.return_value
+    assert "message_thread_id" not in kwargs
+
+
+def test_cleanup_notice_is_deleted(monkeypatch):
+    adapter = _make_adapter()
+    bot, sent = _make_bot()
+    adapter._bot = bot
+    message = SimpleNamespace(chat_id=111, message_thread_id=None)
+    tasks = []
+    real_create_task = asyncio.create_task
+
+    async def instant_sleep(_delay):
+        return None
+
+    def capture_task(coro):
+        task = real_create_task(coro)
+        tasks.append(task)
+        return task
+
+    monkeypatch.setattr(asyncio, "sleep", instant_sleep)
+    monkeypatch.setattr(asyncio, "create_task", capture_task)
+
+    async def run():
+        await adapter._remove_location_request_keyboard(message)
+        await tasks[0]
+
+    asyncio.run(run())
+
+    bot.delete_message.assert_awaited_once_with(
+        chat_id=111, message_id=sent.message_id
+    )
+
+
+def test_thread_send_failure_retries_without_thread_id():
+    adapter = _make_adapter()
+    bot, sent = _make_bot()
+    bot.send_message.side_effect = [RuntimeError("thread unavailable"), sent]
+    adapter._bot = bot
+    message = SimpleNamespace(chat_id=111, message_thread_id=7)
+
+    asyncio.run(adapter._remove_location_request_keyboard(message))
+
+    first, second = bot.send_message.await_args_list
+    assert first.kwargs["message_thread_id"] == 7
+    assert "message_thread_id" not in second.kwargs
+
+
+def test_missing_bot_or_chat_id_is_a_noop():
+    adapter = _make_adapter()
+    adapter._bot = None
+    asyncio.run(
+        adapter._remove_location_request_keyboard(SimpleNamespace(chat_id=111))
+    )
+
+    bot, _sent = _make_bot()
+    adapter._bot = bot
+    asyncio.run(
+        adapter._remove_location_request_keyboard(SimpleNamespace(chat_id=None))
+    )
+    bot.send_message.assert_not_awaited()
+
+
+def _location_update(message):
+    return SimpleNamespace(
+        effective_message=message, message=message, update_id=1
+    )
+
+
+def _wire_location_flow(adapter, monkeypatch):
+    cleaned = []
+    handled = []
+    monkeypatch.setattr(
+        adapter, "_is_user_authorized_from_message", lambda _message: True
+    )
+    monkeypatch.setattr(adapter, "_should_process_message", lambda _message: True)
+
+    async def record_cleanup(message):
+        cleaned.append(message)
+
+    async def record_handle(event):
+        handled.append(event)
+
+    monkeypatch.setattr(adapter, "_remove_location_request_keyboard", record_cleanup)
+    monkeypatch.setattr(
+        adapter,
+        "_build_message_event",
+        lambda *_args, **_kwargs: SimpleNamespace(text=""),
+    )
+    monkeypatch.setattr(
+        adapter, "_apply_telegram_group_observe_attribution", lambda event: event
+    )
+    monkeypatch.setattr(adapter, "handle_message", record_handle)
+    return cleaned, handled
+
+
+def test_location_dispatch_cleans_keyboard_first(monkeypatch):
+    adapter = _make_adapter()
+    cleaned, handled = _wire_location_flow(adapter, monkeypatch)
+    message = SimpleNamespace(
+        chat_id=111,
+        message_thread_id=None,
+        venue=None,
+        location=SimpleNamespace(latitude=52.52, longitude=13.405),
+    )
+
+    asyncio.run(adapter._handle_location_message(_location_update(message), None))
+
+    assert cleaned == [message]
+    assert len(handled) == 1
+    assert "52.52" in handled[0].text
+
+
+def test_update_without_coordinates_keeps_keyboard(monkeypatch):
+    adapter = _make_adapter()
+    cleaned, handled = _wire_location_flow(adapter, monkeypatch)
+    message = SimpleNamespace(
+        chat_id=111,
+        message_thread_id=None,
+        venue=None,
+        location=SimpleNamespace(latitude=None, longitude=13.405),
+    )
+
+    asyncio.run(adapter._handle_location_message(_location_update(message), None))
+
+    assert cleaned == []
+    assert handled == []
