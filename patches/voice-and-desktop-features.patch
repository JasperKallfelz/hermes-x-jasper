+            "chat_id": int(chat_id),
+            "text": "📍 Standort erhalten.",
+            "reply_markup": _ReplyKeyboardRemove(),
+        }
+        thread_id = getattr(msg, "message_thread_id", None)
+        if thread_id is not None:
+            kwargs["message_thread_id"] = thread_id
+
+        try:
+            sent = await bot.send_message(**kwargs)
+        except Exception as first_err:
+            # Some private-topic/forum edge cases reject message_thread_id for
+            # control messages. Retry once without it: removing the keyboard is
+            # chat-scoped, so a plain chat send is still enough.
+            if "message_thread_id" not in kwargs:
+                logger.debug("[%s] Failed to remove location keyboard: %s", self.name, first_err)
