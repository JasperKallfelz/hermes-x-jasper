+"""Behavior contracts for Discord's non-blocking voice capture boundary."""
+
+from __future__ import annotations
+
+import asyncio
+from unittest.mock import MagicMock
+
+import pytest
+
+from plugins.platforms.discord.adapter import DiscordAdapter, VoiceReceiver
+
+
+class _Receiver:
+    SAMPLE_RATE = 48_000
+    CHANNELS = 2
+
+    def __init__(self) -> None:
+        self._running = True
+        self.polls = 0
+        self.second_poll = asyncio.Event()
+
+    def active_speakers(self, *, min_duration_ms: int = 0):
+        return []
+
+    def drain_stream_chunks(self):
+        return []
+
+    def check_silence(self, *, silence_threshold=None):
+        self.polls += 1
+        if self.polls == 1:
+            return [(42, b"pcm")]
+        self._running = False
+        self.second_poll.set()
+        return []
+
+
+def _make_adapter(receiver: _Receiver) -> DiscordAdapter:
+    adapter = object.__new__(DiscordAdapter)
+    adapter._client = MagicMock()
+    adapter._client.get_guild.return_value = MagicMock()
+    adapter._voice_clients = {}
+    adapter._voice_receivers = {111: receiver}
+    adapter._voice_mixers = {}
+    adapter._voice_fx_cfg = {
+        "barge_in_enabled": True,
+        "barge_in_min_ms": 320,
+        "streaming_stt_endpoint_silence": 0.45,
+        "turn_queue_maxsize": 4,
+    }
+    adapter._voice_barge_in = None
+    adapter._voice_input_callback = None
+    adapter._voice_turn_queues = {}
+    adapter._voice_turn_worker_tasks = {}
+    adapter._streaming_stt = None
+    adapter._streaming_partials = {}
+    adapter._allowed_user_ids = set()
+    adapter._allowed_role_ids = set()
+    adapter._voice_timeout_tasks = {}
+    adapter._reset_voice_timeout = MagicMock()
+    return adapter
+
+
+@pytest.mark.asyncio
+async def test_capture_loop_keeps_polling_while_previous_turn_is_processing():
+    """A slow Hermes turn must not block VAD/barge-in polling."""
+    receiver = _Receiver()
+    adapter = _make_adapter(receiver)
+    processing_started = asyncio.Event()
+    release_processing = asyncio.Event()
+
+    async def slow_process(*args, **kwargs):
+        processing_started.set()
+        await release_processing.wait()
+
+    adapter._process_voice_input = slow_process
+
+    listen_task = asyncio.create_task(adapter._voice_listen_loop(111))
+    try:
+        await asyncio.wait_for(processing_started.wait(), timeout=1.0)
+        await asyncio.wait_for(receiver.second_poll.wait(), timeout=1.0)
+        assert receiver.polls >= 2
+    finally:
+        release_processing.set()
+        await asyncio.wait_for(listen_task, timeout=1.0)
+        worker = adapter._voice_turn_worker_tasks.get(111)
+        if worker is not None:
+            worker.cancel()
+            with pytest.raises(asyncio.CancelledError):
+                await worker
+
+
+def test_receiver_caps_pcm_buffer_and_keeps_stream_offset_valid():
+    """A blocked consumer cannot make per-speaker PCM grow without bound."""
+    vc = MagicMock()
+    receiver = VoiceReceiver(vc, max_buffer_seconds=0.1)
+    receiver.map_ssrc(7, 42)
+
+    bytes_per_second = receiver.SAMPLE_RATE * receiver.CHANNELS * 2
+    receiver._append_pcm(7, b"a" * int(bytes_per_second * 0.06))
+    chunks = receiver.drain_stream_chunks()
+    assert chunks and chunks[0][1] == 42
+
+    receiver._append_pcm(7, b"b" * int(bytes_per_second * 0.10))
+
+    assert len(receiver._buffers[7]) <= int(bytes_per_second * 0.1)
+    assert 0 <= receiver._stream_offsets[7] <= len(receiver._buffers[7])
