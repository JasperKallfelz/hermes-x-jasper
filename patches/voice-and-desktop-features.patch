+
+def normalize_voice_text(text: str) -> str:
+    """Return a compact lowercase string for routing heuristics."""
+    return re.sub(r"\s+", " ", (text or "").strip()).lower()
+
+
+def detect_voice_language(text: str, *, default: str = "de") -> str:
+    """Best-effort German/English language choice for replies.
+
+    Defaults to German for short/ambiguous turns and switches to English when the
+    speaker clearly uses English. Pass `default="en"` to flip the fallback.
+    """
+    normalized = normalize_voice_text(text)
+    words = re.findall(r"[a-zäöüß']+", normalized)
+    de_markers = {
+        "ich", "du", "wir", "der", "die", "das", "ein", "eine", "einen",
+        "und", "oder", "nicht", "mit", "mir", "mich", "bitte", "danke",
+        "bau", "baue", "mach", "mache", "schick", "vorschau", "webseite",
+        "aufgabe", "status", "stand",
+    }
+    en_markers = {
+        "i", "you", "we", "the", "a", "an", "and", "or", "not", "with",
+        "me", "my", "your", "please", "thanks", "build", "make", "create",
+        "send", "preview", "website", "task", "status",
+    }
+    de_score = sum(1 for w in words if w in de_markers)
+    en_score = sum(1 for w in words if w in en_markers)
+    if any(ch in normalized for ch in "äöüß"):
+        de_score += 2
+    if en_score > de_score + 1:
+        return "en"
+    return default
+
+
+def looks_like_backchannel(text: str) -> bool:
+    normalized = normalize_voice_text(text)
+    compact = re.sub(r"[^a-zäöüß\s-]", "", normalized).strip()
+    if not compact or len(compact) > 32:
+        return False
+    words = compact.split()
+    if len(words) > 3:
+        return False
+    return compact in _BACKCHANNEL_TERMS or all(word in _BACKCHANNEL_TERMS for word in words)
+
+
+def looks_like_greeting(text: str) -> bool:
+    normalized = normalize_voice_text(text)
+    if not normalized or len(normalized) > 80:
+        return False
+    if any(term in normalized for term in _TASK_TERMS + _TASK_OBJECT_TERMS):
+        return False
+    if any(phrase in normalized for phrase in (
+        "hörst du mich", "hoerst du mich", "can you hear me", "are you there",
+    )):
+        return True
+    words = re.findall(r"[a-zäöüß]+", normalized)
+    return bool(words) and all(
+        word in {"hallo", "hello", "hey", "hi", "servus", "moin"}
+        for word in words
+    )
+
+
+def looks_like_status_request(text: str) -> bool:
+    normalized = normalize_voice_text(text)
+    return any(term in normalized for term in _STATUS_TERMS)
+
+
+def parse_spoken_voice_command(text: str) -> Optional[str]:
+    """Resolve a deliberately small set of exact, safe spoken commands."""
+    normalized = normalize_voice_text(text)
+    normalized = re.sub(r"[^a-zäöüß\s]", "", normalized)
+    normalized = re.sub(r"\s+", " ", normalized).strip()
+    phrases = {
+        "new": {
+            "new chat", "new session", "start a new chat", "start new chat",
+            "neuer chat", "neuen chat", "neue session", "starte einen neuen chat",
+            "starte eine neue session", "mach einen neuen chat",
+        },
+        "stop": {
+            "stop", "stopp", "stop task", "cancel task", "hör auf", "hoer auf",
+            "brich ab", "abbrechen",
+        },
+        "agents": {
+            "agent status", "agents status", "subagent status", "welche agenten laufen",
+            "welche subagenten laufen", "show agents",
+        },
+        "help": {
+            "voice commands", "sprachbefehle", "welche sprachbefehle gibt es",
+            "show voice commands",
+        },
+    }
+    for command, variants in phrases.items():
+        if normalized in variants:
+            return command
+    return None
+
+
+def looks_like_voice_task(text: str) -> bool:
+    """Heuristic for spoken task handoff requests.
+
+    Keep this deliberately conservative: a task verb plus either a concrete
+    build/coding object or a delivery/preview phrase.  This avoids turning casual
+    conversation into background jobs.
+    """
+    normalized = normalize_voice_text(text)
+    if len(normalized) < 8:
+        return False
+    has_task_verb = any(term in normalized for term in _TASK_TERMS)
+    if not has_task_verb:
+        return False
+    has_object = any(term in normalized for term in _TASK_OBJECT_TERMS)
+    has_delivery = any(term in normalized for term in _DELIVERY_TERMS)
+    return has_object or has_delivery
+
+
+def should_delegate_voice_task(text: str) -> bool:
+    """Use native detached subagents for substantive, non-personal voice work."""
+    if not looks_like_voice_task(text):
+        return False
+    return route_voice_worker(text) in {"coding", "research", "browser", "automation"}
+
+
+def route_voice_worker(text: str, *, default: str = "coding") -> str:
+    """Conservatively classify a typed worker without claiming execution."""
+    normalized = normalize_voice_text(text)
+    routes = {
+        "mail": ("mail", "email", "e-mail", "inbox", "postfach"),
+        "calendar": ("calendar", "kalender", "termin", "meeting"),
+        "research": ("research", "recherch", "untersuch", "analyse"),
+        "browser": ("browser", "webseite öffnen", "open website", "klick"),
+        "automation": ("automation", "automatisier", "workflow", "cron"),
+        "personal": ("persönlich", "personal", "erinner mich", "remember for me"),
+    }
+    for kind, terms in routes.items():
+        if any(term in normalized for term in terms):
+            return kind
+    return default
+
+
+def describe_voice_action(
+    tool_name: str,
+    args: Optional[dict[str, Any]] = None,
+    *,
+    language: str = "de",
+) -> str:
+    """Describe the first concrete tool action in one short spoken sentence."""
+    name = (tool_name or "").lower()
+    params = args if isinstance(args, dict) else {}
+    toolkit = str(params.get("toolkit", "")).lower()
+    english = language == "en"
+
+    if "gmail_create_email_draft" in name:
+        return "I’m drafting the email." if english else "Ich erstelle den E-Mail-Entwurf."
+    if "gmail_reply_to_thread" in name:
+        return "I’m replying to the email." if english else "Ich beantworte die E-Mail."
+    if "gmail_send_email" in name or "gmail_send_draft" in name:
+        return "I’m sending the email." if english else "Ich sende die E-Mail."
+    if "gmail" in name and any(term in name for term in ("fetch", "profile", "list", "search")):
+        return "I’m reading your emails." if english else "Ich lese deine Mails."
+    if "googlecalendar_create_event" in name:
+        return "I’m creating the calendar event." if english else "Ich erstelle den Termin."
+    if "googlecalendar_delete_event" in name:
+        return "I’m deleting the calendar event." if english else "Ich lösche den Termin."
+    if "googlecalendar" in name:
+        return "I’m checking your calendar." if english else "Ich prüfe deinen Kalender."
+    if "composio_check_active_connection" in name and toolkit:
+        if "gmail" in toolkit:
+            return "I’m checking email access." if english else "Ich prüfe den Mailzugriff."
+        if "calendar" in toolkit:
+            return "I’m checking calendar access." if english else "Ich prüfe den Kalenderzugriff."
+    if name in {"read_file", "search_files", "patch", "write_file"}:
+        return "I’m checking the files." if english else "Ich prüfe die Dateien."
+    if name in {"browser_navigate", "browser_click", "browser_type", "browser_console"}:
+        return "I’m checking that in the browser." if english else "Ich prüfe das im Browser."
+    if "search" in name or "research" in name or name == "web_extract":
+        return "I’m researching that." if english else "Ich recherchiere das."
+    if name == "delegate_task":
+        return "I’m starting a background agent." if english else "Ich starte einen Hintergrund-Agenten."
+    if name in {"terminal", "execute_code"}:
+        return "I’m running the check." if english else "Ich führe die Prüfung aus."
+    if name == "image_generate":
+        return "I’m creating the image." if english else "Ich erstelle das Bild."
+    return "I’m doing that now." if english else "Ich führe das jetzt aus."
+
+
+def describe_background_voice_action(worker_kind: str, *, language: str = "de") -> str:
+    """Describe a typed background handoff without a vague reassurance."""
+    english = language == "en"
+    phrases = {
+        "coding": ("I’m implementing that in the background.", "Ich setze das im Hintergrund um."),
+        "mail": ("I’m processing the emails in the background.", "Ich bearbeite die Mails im Hintergrund."),
+        "calendar": ("I’m updating the calendar in the background.", "Ich aktualisiere den Kalender im Hintergrund."),
+        "research": ("I’m researching that in the background.", "Ich recherchiere das im Hintergrund."),
+        "browser": ("I’m checking that in the browser.", "Ich prüfe das im Browser."),
+        "automation": ("I’m setting up the automation.", "Ich richte die Automatisierung ein."),
+    }
+    pair = phrases.get(worker_kind, ("I’m doing that in the background.", "Ich führe das im Hintergrund aus."))
+    return pair[0] if english else pair[1]
+
+
+def should_background_voice_task(text: str) -> bool:
+    """Return true only when the routed worker can execute in the background.
+
+    Tool-backed mail, calendar, browser, and similar requests must keep flowing
+    through Hermes' normal conversation path until their dedicated workers are
+    wired. This preserves existing capabilities instead of creating a blocked
+    unsupported job for an otherwise valid voice request.
+    """
+    if not looks_like_voice_task(text):
+        return False
+    worker = VoiceWorkerRegistry.default().resolve(route_voice_worker(text))
+    return worker.executable
+
+
+def make_job_title(prompt: str, max_len: int = 72) -> str:
+    text = re.sub(r"\s+", " ", prompt.strip())
+    text = re.sub(r"^(hermes[, ]+)?", "", text, flags=re.IGNORECASE)
+    return text[: max_len - 1].rstrip() + "…" if len(text) > max_len else text
+
+
+@dataclass
+class VoiceJob:
+    id: str
+    title: str
+    prompt: str
+    source: dict[str, Any]
+    status: str = "queued"
+    created_at: float = field(default_factory=time.time)
+    updated_at: float = field(default_factory=time.time)
+    worker: str = "codex"
+    worker_kind: str = "coding"
+    speaker_id: str = "coding"
+    voice_profile: str = "seraphina"
+    error: str = ""
+    result_summary: str = ""
+    artifacts: list[str] = field(default_factory=list)
+    transcript: str = ""
+
+
+class VoiceJobStore:
+    """Small JSON-file backed job store under the active Hermes profile."""
+
+    def __init__(self, root: Optional[Path] = None) -> None:
+        self.root = Path(root) if root is not None else get_hermes_home() / "voice_jobs"
+        self.jobs_dir = self.root / "jobs"
+        self.work_dir = self.root / "work"
+        self.artifacts_dir = self.root / "artifacts"
+        for path in (self.jobs_dir, self.work_dir, self.artifacts_dir):
+            path.mkdir(parents=True, exist_ok=True)
+
+    def new_job_id(self) -> str:
+        return time.strftime("vj_%Y%m%d_%H%M%S_") + f"{os.getpid()}_{uuid.uuid4().hex[:12]}"
+
+    def create(self, *, prompt: str, source: dict[str, Any], transcript: str = "",
+               worker_kind: str = "coding", speaker_id: str = "",
+               voice_profile: str = "seraphina") -> VoiceJob:
+        job = VoiceJob(
+            id=self.new_job_id(),
+            title=make_job_title(prompt),
+            prompt=prompt.strip(),
+            source=source,
+            transcript=transcript or prompt,
+            worker_kind=worker_kind,
+            speaker_id=speaker_id or worker_kind,
+            voice_profile=voice_profile,
+        )
+        self.save(job)
+        return job
+
+    def path_for(self, job_id: str) -> Path:
+        return self.jobs_dir / f"{job_id}.json"
+
+    def save(self, job: VoiceJob) -> None:
+        job.updated_at = time.time()
+        path = self.path_for(job.id)
+        tmp = path.with_suffix(".json.tmp")
+        tmp.write_text(json.dumps(asdict(job), ensure_ascii=False, indent=2), encoding="utf-8")
+        tmp.replace(path)
+
+    def load(self, job_id: str) -> VoiceJob:
+        data = json.loads(self.path_for(job_id).read_text(encoding="utf-8"))
+        return self._decode_job(data)
+
+    @staticmethod
+    def _decode_job(data: Any) -> VoiceJob:
+        if not isinstance(data, dict):
+            raise ValueError("Voice job payload must be an object")
+        allowed = {item.name for item in fields(VoiceJob)}
+        return VoiceJob(**{key: value for key, value in data.items() if key in allowed})
+
+    def update(self, job_id: str, **changes: Any) -> VoiceJob:
+        job = self.load(job_id)
+        for key, value in changes.items():
+            if hasattr(job, key):
+                setattr(job, key, value)
+        self.save(job)
+        return job
+
+    def recent(self, limit: int = 5) -> list[VoiceJob]:
+        jobs: list[VoiceJob] = []
+        for path in sorted(self.jobs_dir.glob("*.json"), key=lambda p: p.stat().st_mtime, reverse=True):
+            try:
+                jobs.append(self._decode_job(json.loads(path.read_text(encoding="utf-8"))))
+            except Exception:
+                continue
+            if len(jobs) >= limit:
+                break
+        return jobs
+
+    def work_path(self, job_id: str) -> Path:
+        path = self.work_dir / job_id
+        path.mkdir(parents=True, exist_ok=True)
+        return path
+
+    def artifact_path(self, job_id: str) -> Path:
+        path = self.artifacts_dir / job_id
+        path.mkdir(parents=True, exist_ok=True)
+        return path
+
+
+@dataclass(frozen=True)
+class VoiceWorker:
+    kind: str
+    executable: bool = False
+    needs_input_message: str = ""
+
+
+class VoiceWorkerRegistry:
+    """Typed routing table; unsupported workers never pretend to execute."""
+
+    def __init__(self, workers: Iterable[VoiceWorker]) -> None:
+        self._workers = {worker.kind: worker for worker in workers}
+
+    @classmethod
+    def default(cls) -> "VoiceWorkerRegistry":
+        workers = [VoiceWorker("coding", executable=True)]
+        workers.extend(
+            VoiceWorker(kind, needs_input_message=f"Voice worker '{kind}' is not configured yet.")
+            for kind in VOICE_WORKER_KINDS if kind != "coding"
+        )
+        return cls(workers)
+
+    def resolve(self, kind: str) -> VoiceWorker:
+        return self._workers.get(
+            kind, VoiceWorker(kind, needs_input_message=f"Unknown voice worker '{kind}'.")
+        )
+
+
+class VoiceJobRunner:
+    """Opt-in legacy external worker; native ``delegate_task`` is the default."""
+
+    def __init__(self, store: VoiceJobStore, notify: NotifyCallback, *,
+                 timeout: Optional[float] = None,
+                 workers: Optional[VoiceWorkerRegistry] = None,
+                 enable_external_cli: bool = False) -> None:
+        self.store = store
+        self.notify = notify
+        self.timeout = timeout or 1800.0
+        self.workers = workers or VoiceWorkerRegistry.default()
+        self.enable_external_cli = enable_external_cli
+
+    async def run(self, job_id: str) -> None:
+        if not self.enable_external_cli:
+            job = self.store.update(
+                job_id,
+                status="needs_input",
+                error="External CLI voice workers are disabled; use native delegate_task.",
+            )
+            await self.notify(
+                f"⚠️ Task blockiert: **{job.title}** — externer CLI-Worker ist deaktiviert.",
+                {"job_id": job.id, "status": job.status},
+            )
+            return
+        job = self.store.update(job_id, status="running")
+        await self.notify(f"🛠️ Task läuft: **{job.title}** (`{job.id}`)", {"job_id": job.id, "status": "running"})
+
+        worker = self.workers.resolve(job.worker_kind)
+        if not worker.executable:
+            job = self.store.update(job.id, status="needs_input", error=worker.needs_input_message)
+            await self.notify(
+                f"⚠️ Task blockiert: **{job.title}** — {worker.needs_input_message}",
+                {"job_id": job.id, "status": job.status,
+                 "worker_kind": job.worker_kind, "speaker_id": job.speaker_id,
+                 "voice_profile": job.voice_profile},
+            )
+            return
+
+        codex = shutil.which("codex")
+        hermes = shutil.which("hermes")
+        if not codex and not hermes:
+            job = self.store.update(
+                job.id,
+                status="needs_input",
+                error="No voice worker found: install/login Codex CLI or ensure hermes CLI is in PATH.",
+            )
+            await self.notify(
+                f"⚠️ Task blockiert: **{job.title}** — kein Worker gefunden.",
+                {"job_id": job.id, "status": job.status},
+            )
+            return
+
+        workdir = self.store.work_path(job.id)
+        self._ensure_git_repo(workdir)
+        (workdir / "TASK.md").write_text(self._task_markdown(job), encoding="utf-8")
+
+        output = ""
+        returncode = 1
+        worker_name = "codex" if codex else "hermes"
+        try:
+            if codex:
+                returncode, output = await self._run_worker(
+                    [codex, "exec", "--sandbox", "danger-full-access", self._codex_prompt(job)],
+                    workdir,
+                )
+                # The standalone Codex CLI can be unauthenticated even when
+                # Hermes' own openai-codex provider works. Fall back to Hermes
+                # oneshot so the voice-worker path remains useful out of the box.
+                if returncode != 0 and hermes and self._looks_like_codex_auth_failure(output):
+                    worker_name = "hermes"
+                    returncode, output = await self._run_worker(
+                        [hermes, "-z", self._hermes_prompt(job), "--yolo"],
+                        workdir,
+                    )
+            elif hermes:
+                worker_name = "hermes"
+                returncode, output = await self._run_worker(
+                    [hermes, "-z", self._hermes_prompt(job), "--yolo"],
+                    workdir,
+                )
+        except asyncio.TimeoutError:
+            job = self.store.update(job.id, status="failed", error=f"Worker timed out after {self.timeout:g}s")
+            await self.notify(f"❌ Task timeout: **{job.title}** (`{job.id}`)", {"job_id": job.id, "status": job.status})
+            return
+        except Exception as exc:
+            job = self.store.update(job.id, status="failed", error=str(exc))
+            await self.notify(f"❌ Task fehlgeschlagen: **{job.title}** — {str(exc)[:300]}", {"job_id": job.id, "status": job.status})
+            return
+
+        job = self.store.update(job.id, worker=worker_name)
+
+        log_path = self.store.artifact_path(job.id) / "worker-output.txt"
+        log_path.write_text(output[-20000:], encoding="utf-8")
+        artifacts = [str(p) for p in self._collect_artifacts(workdir, log_path.parent)]
+        if str(log_path) not in artifacts:
+            artifacts.append(str(log_path))
+
+        if returncode == 0:
+            summary = self._summarize_success(output, artifacts)
+            job = self.store.update(job.id, status="completed", result_summary=summary, artifacts=artifacts)
+            await self.notify(self._completion_message(job), {
+                "job_id": job.id,
+                "status": job.status,
+                "artifacts": artifacts,
+                "worker_kind": job.worker_kind,
+                "speaker_id": job.speaker_id,
+                "voice_profile": job.voice_profile,
+                "voice_announcement": (
+                    "The background task is finished."
+                    if detect_voice_language(job.transcript) == "en"
+                    else "Der Hintergrund-Task ist fertig."
+                ),
+            })
+        else:
+            error = self._tail(output, 1600) or f"{worker_name} exited with code {returncode}"
+            job = self.store.update(job.id, status="failed", error=error, artifacts=artifacts)
+            await self.notify(f"❌ Task fehlgeschlagen: **{job.title}** (`{job.id}`)\n```\n{error[:1500]}\n```", {"job_id": job.id, "status": job.status})
+
+    def _ensure_git_repo(self, workdir: Path) -> None:
+        if (workdir / ".git").exists():
+            return
+        subprocess.run(["git", "init"], cwd=workdir, check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+
+    def _task_markdown(self, job: VoiceJob) -> str:
+        return f"# Voice Job {job.id}\n\nTitle: {job.title}\n\nPrompt:\n\n{job.prompt}\n"
+
+    def _codex_prompt(self, job: VoiceJob) -> str:
+        return (
+            "You are a background worker for Hermes Discord voice mode. "
+            "Build the user's requested artifact in this isolated git repo. "
+            "Keep it small, working, and mobile-preview friendly. "
+            "If you build a web app, produce an index.html or clear run instructions. "
+            "Do not access secrets or destructive paths. User request:\n\n"
+            f"{job.prompt}"
+        )
+
+    def _hermes_prompt(self, job: VoiceJob) -> str:
+        return (
+            "You are a background worker launched by Hermes Discord voice mode. "
+            "The current working directory is an isolated git repo for this one task. "
+            "Build the requested artifact with real files. Keep it small, working, "
+            "and mobile-preview friendly. If it is a web/app request, create an "
+            "index.html or clear run instructions. Do not touch files outside the "
+            "current working directory. User request:\n\n"
+            f"{job.prompt}"
+        )
+
+    async def _run_worker(self, cmd: list[str], workdir: Path) -> tuple[int, str]:
+        env = dict(os.environ)
+        for key in list(env):
+            if key.startswith("HERMES_GATEWAY") or key in {
+                "_HERMES_GATEWAY",
+                "HERMES_SESSION_SOURCE",
+                "HERMES_SESSION_KEY",
+                "HERMES_SESSION_ID",
+            }:
+                env.pop(key, None)
+        proc = await asyncio.create_subprocess_exec(
+            *cmd,
+            cwd=str(workdir),
+            env=env,
+            stdout=asyncio.subprocess.PIPE,
+            stderr=asyncio.subprocess.STDOUT,
+        )
+        try:
+            stdout_bytes, _ = await asyncio.wait_for(proc.communicate(), timeout=self.timeout)
+        except asyncio.TimeoutError:
+            proc.kill()
+            try:
+                await proc.wait()
+            except Exception:
+                pass
+            raise
+        return proc.returncode or 0, (stdout_bytes or b"").decode("utf-8", errors="replace")
+
+    def _looks_like_codex_auth_failure(self, output: str) -> bool:
+        lowered = (output or "").lower()
+        return "401 unauthorized" in lowered or "missing bearer" in lowered or "authentication" in lowered
+
+    def _collect_artifacts(self, workdir: Path, artifact_dir: Path) -> Iterable[Path]:
+        copied: list[Path] = []
+        for path in workdir.rglob("*"):
+            if ".git" in path.parts or not path.is_file():
+                continue
+            if path.suffix.lower() not in _SAFE_EXTENSIONS:
+                continue
+            rel = path.relative_to(workdir)
+            dest = artifact_dir / rel
+            dest.parent.mkdir(parents=True, exist_ok=True)
+            try:
+                shutil.copy2(path, dest)
+                copied.append(dest)
+            except OSError:
+                continue
+        return copied[:20]
+
+    def _completion_message(self, job: VoiceJob) -> str:
+        artifacts = job.artifacts[:6]
+        artifact_lines = "\n".join(f"- `{p}`" for p in artifacts) if artifacts else "- Keine Artefakte gefunden"
+        return (
+            f"✅ Task fertig: **{job.title}** (`{job.id}`)\n"
+            f"{job.result_summary}\n\n"
+            f"Artefakte/Preview:\n{artifact_lines}"
+        )
+
+    def _summarize_success(self, output: str, artifacts: list[str]) -> str:
+        html = next((p for p in artifacts if p.lower().endswith((".html", ".htm"))), None)
+        if html:
+            return f"Preview-Datei bereit: `{html}`"
+        tail = self._tail(output, 500)
+        return tail or "Worker abgeschlossen."
+
+    def _tail(self, text: str, limit: int) -> str:
+        text = re.sub(r"\x1b\[[0-9;]*[A-Za-z]", "", text or "").strip()
+        return text[-limit:]
+
