@@ -0,0 +1,160 @@
+"""Runtime-only TTS overrides used by transport speaker personas.
+
+These overrides let internal callers (e.g. a per-channel speaker persona) pick a
+provider/voice at call time without mutating the user's loaded ``tts`` config and
+without ever exposing the knobs to the model-facing tool schema.
+"""
+
+import pytest
+
+
+def test_runtime_overrides_are_provider_scoped_and_do_not_mutate_config():
+    from tools.tts_tool import _apply_runtime_tts_overrides
+
+    original = {
+        "provider": "openai",
+        "voice": "global-old",
+        "edge": {"voice": "edge-old", "speed": 1.0},
+    }
+
+    resolved = _apply_runtime_tts_overrides(
+        original,
+        provider="edge",
+        voice="en-US-AriaNeural",
+        model="edge-persona-model",
+        speed=1.15,
+    )
+
+    assert original == {
+        "provider": "openai",
+        "voice": "global-old",
+        "edge": {"voice": "edge-old", "speed": 1.0},
+    }
+    assert resolved["provider"] == "edge"
+    assert resolved["voice"] == "en-US-AriaNeural"
+    assert resolved["model"] == "edge-persona-model"
+    assert resolved["speed"] == 1.15
+    assert resolved["edge"]["voice"] == "en-US-AriaNeural"
+    assert resolved["edge"]["voice_id"] == "en-US-AriaNeural"
+    assert resolved["edge"]["model"] == "edge-persona-model"
+    assert resolved["edge"]["model_id"] == "edge-persona-model"
