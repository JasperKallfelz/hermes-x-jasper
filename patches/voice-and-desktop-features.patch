+def test_voice_job_store_creates_unique_jobs_concurrently_at_one_timestamp(tmp_path, monkeypatch):
+    store = VoiceJobStore(tmp_path / "voice_jobs")
+    monkeypatch.setattr("gateway.voice_jobs.time.time", lambda: 1_700_000_000.123)
+    monkeypatch.setattr("gateway.voice_jobs.time.strftime", lambda _format: "vj_20231114_221320_")
+
+    def create_job(index):
+        return store.create(prompt=f"job {index}", source={"index": index})
+
+    with ThreadPoolExecutor(max_workers=16) as pool:
+        jobs = list(pool.map(create_job, range(64)))
+
+    assert len({job.id for job in jobs}) == len(jobs)
+    assert {job.id for job in store.recent(limit=100)} == {job.id for job in jobs}
