     return (tts_config.get("provider") or DEFAULT_PROVIDER).lower().strip()
 
 
+def _apply_runtime_tts_overrides(
+    tts_config: Dict[str, Any],
+    *,
+    provider: Optional[str] = None,
+    voice: Optional[str] = None,
+    model: Optional[str] = None,
+    speed: Optional[float] = None,
+) -> Dict[str, Any]:
+    """Clone TTS config and apply transport-local persona overrides.
+
+    Runtime overrides never mutate the user's loaded config and are deliberately
+    absent from the model-facing tool schema. Values are written both to the
+    generic plugin keys and the selected provider block because built-in and
+    plugin providers resolve their options from different levels.
+    """
+    resolved = copy.deepcopy(tts_config) if isinstance(tts_config, dict) else {}
+    selected = str(provider or _get_provider(resolved)).lower().strip()
+    if provider:
+        resolved["provider"] = selected
+
+    values = {"voice": voice, "model": model, "speed": speed}
+    for key, value in values.items():
+        if value is not None and value != "":
+            resolved[key] = value
+
+    provider_config = dict(resolved.get(selected) or {})
+    if voice:
+        provider_config["voice"] = voice
+        provider_config["voice_id"] = voice
+    if model:
+        provider_config["model"] = model
+        provider_config["model_id"] = model
+    if speed is not None:
+        provider_config["speed"] = speed
+    resolved[selected] = provider_config
+
+    named_providers = resolved.get("providers")
+    if isinstance(named_providers, dict) and selected in named_providers:
+        named_providers[selected] = {
+            **dict(named_providers.get(selected) or {}),
+            **provider_config,
+        }
+    return resolved
+
+
