index 000000000..b031ce657
--- /dev/null
+++ b/plugins/platforms/discord/streaming_stt.py
@@ -0,0 +1,200 @@
+"""Persistent MLX Parakeet streaming transcription for Discord voice.
+
+The optional dependency is imported lazily so Discord remains usable without
+Parakeet/MLX.  One model is shared across per-speaker streaming decoder state;
+all model access is serialized by a lock because MLX model mutation is not
+thread-safe.
+"""
+
+from __future__ import annotations
+
+import logging
+import threading
+from dataclasses import dataclass
+from typing import Any, Hashable, Optional
+
+logger = logging.getLogger(__name__)
+
+
+@dataclass(frozen=True)
+class StreamingSTTStatus:
+    available: bool
+    reason: str = ""
+
+
+class PersistentParakeetSTT:
+    """Lazily load one Parakeet model and maintain isolated speaker streams."""
+
+    def __init__(
+        self,
+        model_id: str = "mlx-community/parakeet-tdt-0.6b-v3",
+        *,
+        left_context: int = 256,
+        right_context: int = 256,
+        depth: int = 1,
+        min_chunk_ms: int = 500,
+    ) -> None:
+        self.model_id = model_id
+        self.context_size = (max(1, int(left_context)), max(1, int(right_context)))
+        self.depth = max(1, int(depth))
+        self.min_chunk_ms = max(0, int(min_chunk_ms))
+        self._lock = threading.RLock()
+        self._model: Any = None
+        self._mx: Any = None
+        self._np: Any = None
+        self._streams: dict[Hashable, Any] = {}
+        self._pending_pcm: dict[Hashable, bytearray] = {}
+        self._unavailable_reason = "not_initialized"
+
+    @property
+    def status(self) -> StreamingSTTStatus:
+        with self._lock:
+            return StreamingSTTStatus(
+                available=self._model is not None,
+                reason="" if self._model is not None else self._unavailable_reason,
+            )
+
+    def prewarm(self) -> bool:
+        """Load the model once. Returns False when optional support is unavailable."""
+        with self._lock:
+            if self._model is not None:
+                return True
+            if self._unavailable_reason not in {"not_initialized", "load_failed"}:
+                return False
+            try:
+                import mlx.core as mx  # type: ignore
+                import numpy as np  # type: ignore
+                import parakeet_mlx  # type: ignore
+
+                model = parakeet_mlx.from_pretrained(self.model_id)
+                # StreamingParakeet normally switches attention in __enter__.
+                # Set it once on the shared model so several isolated decoder/cache
+                # instances can coexist without one stream's __exit__ reverting it.
+                model.encoder.set_attention_model("rel_pos_local_attn", self.context_size)
+                self._mx = mx
+                self._np = np
+                self._model = model
+                self._unavailable_reason = ""
+                logger.info(
+                    "Persistent Parakeet STT ready (model=%s context=%s depth=%d)",
+                    self.model_id,
+                    self.context_size,
+                    self.depth,
+                )
+                return True
+            except ImportError as exc:
+                self._unavailable_reason = f"dependency_missing:{type(exc).__name__}"
+                logger.info("Persistent Parakeet STT unavailable (%s)", self._unavailable_reason)
+                return False
+            except Exception as exc:
+                self._unavailable_reason = "load_failed"
+                logger.warning("Persistent Parakeet STT failed to load: %s", exc)
+                return False
+
+    def _new_stream(self) -> Any:
+        # Avoid the context manager because its __exit__ mutates the shared model.
+        return self._model.transcribe_stream(
+            context_size=self.context_size,
+            depth=self.depth,
+        )
+
+    def _pcm_to_16k_mono(self, pcm: bytes, sample_rate: int, channels: int) -> Any:
+        if not pcm or sample_rate <= 0 or channels <= 0 or len(pcm) % 2:
+            raise ValueError("invalid PCM geometry")
+        np = self._np
+        samples = np.frombuffer(pcm, dtype="<i2")
+        usable = (samples.size // channels) * channels
+        if usable == 0:
+            raise ValueError("empty PCM frame")
+        samples = samples[:usable].reshape(-1, channels).astype(np.float32)
+        mono = samples.mean(axis=1) / 32768.0
+        if sample_rate != 16000:
+            # Discord is exactly 48 kHz, so decimation is deterministic and keeps
+            # chunk boundaries stable. Other rates use linear interpolation.
+            if sample_rate == 48000:
+                mono = mono[::3]
+            else:
+                output_count = max(1, round(mono.size * 16000 / sample_rate))
+                old_x = np.arange(mono.size, dtype=np.float32)
+                new_x = np.linspace(0, max(0, mono.size - 1), output_count, dtype=np.float32)
+                mono = np.interp(new_x, old_x, mono).astype(np.float32)
+        return self._mx.array(mono)
+
+    def feed_pcm(
+        self,
+        key: Hashable,
+        pcm: bytes,
+        *,
+        sample_rate: int = 48000,
+        channels: int = 2,
+    ) -> Optional[str]:
+        """Feed one new PCM chunk and return the current partial transcript."""
+        with self._lock:
+            if not self.prewarm():
+                return None
+            if not pcm:
+                self._streams.pop(key, None)
+                self._pending_pcm.pop(key, None)
+                return None
+            try:
+                stream = self._streams.get(key)
+                if stream is None:
+                    stream = self._new_stream()
+                    self._streams[key] = stream
+                pending = self._pending_pcm.setdefault(key, bytearray())
+                pending.extend(pcm)
+                min_bytes = int(
+                    sample_rate * channels * 2 * self.min_chunk_ms / 1000
+                )
+                if min_bytes <= 0:
+                    min_bytes = len(pending)
+                while min_bytes and len(pending) >= min_bytes:
+                    chunk = bytes(pending[:min_bytes])
+                    del pending[:min_bytes]
+                    stream.add_audio(
+                        self._pcm_to_16k_mono(chunk, sample_rate, channels)
+                    )
+                return str(getattr(stream.result, "text", "") or "").strip()
+            except Exception as exc:
+                self._streams.pop(key, None)
+                self._pending_pcm.pop(key, None)
+                logger.warning("Persistent Parakeet stream failed; resetting key: %s", exc)
+                return None
+
+    def finalize(self, key: Hashable) -> Optional[str]:
+        """Return the latest transcript and discard only this speaker's state."""
+        with self._lock:
+            stream = self._streams.pop(key, None)
+            pending = self._pending_pcm.pop(key, bytearray())
+            if stream is None:
+                return None
+            try:
+                if pending:
+                    stream.add_audio(
+                        self._pcm_to_16k_mono(bytes(pending), 48000, 2)
+                    )
+                return str(getattr(stream.result, "text", "") or "").strip()
+            except Exception:
+                return None
+
+    def reset(self, key: Hashable) -> None:
+        with self._lock:
+            self._streams.pop(key, None)
+            self._pending_pcm.pop(key, None)
+
+    def reset_conversation(self, conversation_id: Hashable) -> None:
+        """Drop streams whose tuple key begins with the supplied conversation id."""
+        with self._lock:
+            for key in list(self._streams):
+                if isinstance(key, tuple) and key and key[0] == conversation_id:
+                    self._streams.pop(key, None)
+                    self._pending_pcm.pop(key, None)
+
+    def close(self) -> None:
+        with self._lock:
+            self._streams.clear()
+            self._pending_pcm.clear()
+            self._model = None
+            self._mx = None
+            self._np = None
+            self._unavailable_reason = "closed"
