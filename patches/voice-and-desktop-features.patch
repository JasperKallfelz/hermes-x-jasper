+_SAFE_EXTENSIONS = {
+    ".html", ".htm", ".css", ".js", ".ts", ".tsx", ".jsx", ".py", ".md",
+    ".json", ".png", ".jpg", ".jpeg", ".gif", ".svg", ".pdf", ".txt",
+}
