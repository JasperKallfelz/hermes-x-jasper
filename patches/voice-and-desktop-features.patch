+def test_runtime_overrides_are_provider_scoped_and_do_not_mutate_config():
+    from tools.tts_tool import _apply_runtime_tts_overrides
+
+    original = {
+        "provider": "openai",
+        "voice": "global-old",
+        "edge": {"voice": "edge-old", "speed": 1.0},
+    }
+
+    resolved = _apply_runtime_tts_overrides(
+        original,
+        provider="edge",
+        voice="de-DE-SeraphinaMultilingualNeural",
+        model="edge-persona-model",
+        speed=1.15,
+    )
+
+    assert original == {
+        "provider": "openai",
+        "voice": "global-old",
+        "edge": {"voice": "edge-old", "speed": 1.0},
+    }
+    assert resolved["provider"] == "edge"
+    assert resolved["voice"] == "de-DE-SeraphinaMultilingualNeural"
+    assert resolved["model"] == "edge-persona-model"
+    assert resolved["speed"] == 1.15
+    assert resolved["edge"]["voice"] == "de-DE-SeraphinaMultilingualNeural"
+    assert resolved["edge"]["voice_id"] == "de-DE-SeraphinaMultilingualNeural"
+    assert resolved["edge"]["model"] == "edge-persona-model"
+    assert resolved["edge"]["model_id"] == "edge-persona-model"
+    assert resolved["edge"]["speed"] == 1.15
