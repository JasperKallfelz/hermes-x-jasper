new file mode 100644
index 000000000..18cf7e922
--- /dev/null
+++ b/gateway/voice_domain.py
@@ -0,0 +1,124 @@
+"""Dependency-light voice-domain primitives shared by voice transports."""
+from __future__ import annotations
+
+import logging
+import threading
+import time
+from dataclasses import dataclass, field
+from enum import Enum
+from typing import Any, Callable, Mapping, Optional
+
+logger = logging.getLogger(__name__)
+
+
+class VoiceEventType(str, Enum):
+    SPEECH_STARTED = "speech_started"
+    TURN_COMPLETED = "turn_completed"
+    TTS_STARTED = "tts_started"
+    TTS_COMPLETED = "tts_completed"
+    TTS_INTERRUPTED = "tts_interrupted"
+
+
+@dataclass(frozen=True)
+class VoiceEvent:
+    type: VoiceEventType
+    transport: str
+    speaker_id: str = "default"
+    conversation_id: str = ""
+    metadata: Mapping[str, Any] = field(default_factory=dict)
+    timestamp: float = field(default_factory=time.time)
+
+
+VoiceEventHandler = Callable[[VoiceEvent], None]
+
+
+class VoiceEventBus:
+    """Small synchronous event bus; handlers must not block transport loops."""
+
+    def __init__(self) -> None:
+        self._handlers: list[VoiceEventHandler] = []
+        self._lock = threading.Lock()
+
+    def subscribe(self, handler: VoiceEventHandler) -> Callable[[], None]:
+        with self._lock:
+            self._handlers.append(handler)
+
+        def unsubscribe() -> None:
+            with self._lock:
+                if handler in self._handlers:
+                    self._handlers.remove(handler)
+        return unsubscribe
+
+    def publish(self, event: VoiceEvent) -> None:
+        with self._lock:
+            handlers = tuple(self._handlers)
+        for handler in handlers:
+            try:
+                handler(event)
+            except Exception:
+                logger.exception("Voice event handler failed for %s", event.type.value)
+
+
+@dataclass(frozen=True)
+class SpeakerPersona:
+    speaker_id: str = "default"
+    voice_profile: str = "seraphina"
+    voice: str = "de-DE-SeraphinaMultilingualNeural"
+    provider: str = "edge"
+    metadata: Mapping[str, Any] = field(default_factory=dict)
+
+
+class SpeakerPersonaRegistry:
+    def __init__(self, default: SpeakerPersona, speakers: Optional[Mapping[str, SpeakerPersona]] = None) -> None:
+        self.default = default
+        self._speakers = dict(speakers or {})
+
+    @classmethod
+    def from_config(cls, config: Optional[Mapping[str, Any]]) -> "SpeakerPersonaRegistry":
+        raw = dict(config or {})
+        default_raw = dict(raw.get("default") or {})
+        default = SpeakerPersona(
+            speaker_id="default",
+            voice_profile=str(default_raw.get("voice_profile") or "seraphina"),
+            voice=str(default_raw.get("voice") or "de-DE-SeraphinaMultilingualNeural"),
+            provider=str(default_raw.get("provider") or "edge"),
+            metadata=dict(default_raw.get("metadata") or {}),
+        )
+        speakers: dict[str, SpeakerPersona] = {}
+        for speaker_id, value in (raw.get("speakers") or {}).items():
+            if not isinstance(value, Mapping):
+                continue
+            speakers[str(speaker_id)] = SpeakerPersona(
+                speaker_id=str(speaker_id),
+                voice_profile=str(value.get("voice_profile") or default.voice_profile),
+                voice=str(value.get("voice") or default.voice),
+                provider=str(value.get("provider") or default.provider),
+                metadata={**dict(default.metadata), **dict(value.get("metadata") or {})},
+            )
+        return cls(default, speakers)
+
+    def resolve(self, speaker_id: Optional[str]) -> SpeakerPersona:
+        return self._speakers.get(str(speaker_id), self.default)
+
+
+class BargeInState:
+    """Conservative per-speaker threshold and one-shot interruption state."""
+
+    def __init__(self, min_speech_ms: int = 320) -> None:
+        self.min_speech_ms = max(100, int(min_speech_ms))
+        self._interrupted: set[str] = set()
+        self._lock = threading.Lock()
+
+    def observe(self, speaker_id: str, *, buffered_ms: float, tts_active: bool) -> bool:
+        speaker_id = str(speaker_id)
+        if not tts_active or buffered_ms < self.min_speech_ms:
+            return False
+        with self._lock:
+            if speaker_id in self._interrupted:
+                return False
+            self._interrupted.add(speaker_id)
+            return True
+
+    def complete_turn(self, speaker_id: str) -> None:
+        with self._lock:
+            self._interrupted.discard(str(speaker_id))
