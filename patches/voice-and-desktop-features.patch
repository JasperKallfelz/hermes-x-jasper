+def _auto_launch_local_cdp_enabled() -> bool:
+    """Return whether a configured loopback CDP endpoint may be launched.
+
+    An explicitly present ``BROWSER_TOOL_AUTO_CDP`` is the live override,
+    including explicit false values. Otherwise use the persistent
+    ``browser.auto_launch_local_cdp`` config key.
+    """
+    if "BROWSER_TOOL_AUTO_CDP" in os.environ:
+        return is_truthy_value(os.environ["BROWSER_TOOL_AUTO_CDP"])
+    try:
+        from hermes_cli.config import read_raw_config
+
+        cfg = read_raw_config()
+        browser_cfg = cfg.get("browser", {}) if isinstance(cfg, dict) else {}
+        return bool(
+            browser_cfg.get("auto_launch_local_cdp", False)
+            if isinstance(browser_cfg, dict)
+            else False
+        )
+    except Exception as exc:
+        logger.debug(
+            "Could not read browser.auto_launch_local_cdp from config: %s", exc
+        )
+        return False
+
+
+def _ensure_local_cdp_ready(cdp_url: str) -> str:
+    """Launch the managed debug Chrome for a missing loopback CDP endpoint.
+
+    Remote endpoints are never launched locally. On failure, return the input
+    unchanged so the caller surfaces the normal CDP connection error.
+    """
+    if not _auto_launch_local_cdp_enabled():
+        return cdp_url
+
+    from urllib.parse import urlparse
+
+    parsed = urlparse(cdp_url if "://" in cdp_url else f"http://{cdp_url}")
+    host = (parsed.hostname or "").lower()
+    if host not in {"127.0.0.1", "localhost", "::1"}:
+        return cdp_url
+
+    try:
+        from hermes_cli.browser_connect import (
+            is_browser_debug_ready,
+            try_launch_chrome_debug,
+        )
+    except Exception as exc:
+        logger.debug("browser_connect helpers unavailable: %s", exc)
+        return cdp_url
+
+    if is_browser_debug_ready(cdp_url, timeout=1.0):
+        return cdp_url
+
+    try:
+        port = parsed.port or 9222
+    except ValueError:
+        port = 9222
+
+    logger.info(
+        "Auto-CDP enabled: auto-launching local debug Chrome on 127.0.0.1:%s",
+        port,
+    )
+    try:
+        launched = try_launch_chrome_debug(port)
+    except Exception as exc:
+        logger.warning("Auto-launch of debug Chrome failed: %s", exc)
+        launched = False
+
+    if not launched:
+        return cdp_url
+
+    # The launcher only waits through its short grace window. Keep polling for
+    # slower browser startups before resolving the concrete websocket URL.
+    deadline = time.monotonic() + 12.0
+    while time.monotonic() < deadline:
+        if is_browser_debug_ready(cdp_url, timeout=0.05):
+            logger.info("Debug Chrome ready on port %s", port)
+            break
+        time.sleep(0.05)
+    else:
+        logger.warning("Debug Chrome launched but port %s not responding yet", port)
+
+    return _resolve_cdp_override(cdp_url)
