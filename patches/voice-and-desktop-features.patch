+        """Clear any persistent Telegram reply keyboard after a location share.
+
+        Telegram's request-location buttons are reply keyboards: they stay stuck
+        at the bottom of the client until the bot sends a ReplyKeyboardRemove.
+        Once a LOCATION/VENUE update arrives we already have the coordinates, so
+        clear that UI immediately instead of waiting for the agent's later
+        response (which may take tool calls and otherwise leaves the stale
+        "Share location" button visible).
+        """
+        bot = getattr(self, "_bot", None)
+        if not bot:
+            return
+        try:
+            from telegram import ReplyKeyboardRemove as _ReplyKeyboardRemove
+        except Exception:
+            return
+
