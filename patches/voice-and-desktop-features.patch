+    async def _maybe_autojoin_discord_voice(self, adapter) -> None:
+        """Auto-join a configured Discord voice channel on gateway startup.
+
+        Env-gated for personal deployments that want Hermes to sit in a small
+        private voice room all the time instead of waiting for `/voice join`.
+        """
+        voice_channel_raw = os.getenv("DISCORD_VOICE_AUTOJOIN_CHANNEL_ID", "").strip()
+        if not voice_channel_raw:
+            return
+        if not hasattr(adapter, "join_voice_channel"):
+            return
+        try:
+            voice_channel_id = int(voice_channel_raw)
+            configured_guild_id = int(os.getenv("DISCORD_VOICE_AUTOJOIN_GUILD_ID", "").strip() or "0")
+            text_channel_id = int(
+                os.getenv("DISCORD_VOICE_AUTOJOIN_TEXT_CHANNEL_ID", "").strip()
+                or os.getenv("DISCORD_HOME_CHANNEL", "").strip()
+                or "0"
+            )
+        except ValueError:
+            logger.warning("Invalid DISCORD_VOICE_AUTOJOIN_* id; skipping autojoin")
+            return
+
+        client = getattr(adapter, "_client", None)
+        if client is None:
+            return
+        channel = client.get_channel(voice_channel_id)
+        if channel is None and hasattr(client, "fetch_channel"):
+            try:
+                channel = await client.fetch_channel(voice_channel_id)
+            except Exception as exc:
+                logger.warning("Discord voice autojoin: failed to fetch channel %s: %s", voice_channel_id, exc)
+                return
+        if channel is None:
+            logger.warning("Discord voice autojoin: voice channel %s not found", voice_channel_id)
+            return
+
+        guild = getattr(channel, "guild", None)
+        guild_id = configured_guild_id or int(getattr(guild, "id", 0) or 0)
+        if guild_id <= 0:
+            logger.warning("DISCORD_VOICE_AUTOJOIN_CHANNEL_ID set but guild could not be inferred")
+            return
+        if configured_guild_id and int(getattr(guild, "id", configured_guild_id) or configured_guild_id) != configured_guild_id:
+            logger.warning(
+                "Discord voice autojoin: configured guild %s does not match voice channel guild %s",
+                configured_guild_id,
+                getattr(guild, "id", None),
+            )
+            return
+        if text_channel_id <= 0:
+            # Personal always-on deployments usually pair the voice room with a
+            # same-named text channel (e.g. #Allgemein / voice Allgemein).  Make
+            # the voice-channel id the only truly required setting by inferring
+            # that paired text channel when DISCORD_HOME_CHANNEL is absent.
+            channel_name = getattr(channel, "name", None)
+            text_channels = getattr(guild, "text_channels", []) if guild is not None else []
+            paired = next((c for c in text_channels if getattr(c, "name", None) == channel_name), None)
+            text_channel_id = int(getattr(paired, "id", 0) or 0)
+        if text_channel_id <= 0:
+            logger.warning("DISCORD_VOICE_AUTOJOIN_CHANNEL_ID set but text channel missing")
+            return
+
+        if hasattr(adapter, "_voice_input_callback"):
+            adapter._voice_input_callback = self._handle_voice_channel_input
+        if hasattr(adapter, "_on_voice_disconnect"):
+            adapter._on_voice_disconnect = self._handle_voice_timeout_cleanup
+        if hasattr(adapter, "_voice_mode_getter"):
+            adapter._voice_mode_getter = lambda chat_id: self._voice_mode.get(
+                self._voice_key(Platform.DISCORD, str(chat_id)), "off"
+            )
+
+        try:
+            success = await adapter.join_voice_channel(channel)
+        except Exception as exc:
+            logger.warning("Discord voice autojoin failed: %s", exc)
+            return
+        if not success:
+            logger.warning("Discord voice autojoin failed: adapter returned false")
+            return
+
+        adapter._voice_text_channels[guild_id] = text_channel_id
+        source = SessionSource(
+            platform=Platform.DISCORD,
+            chat_id=str(text_channel_id),
+            chat_name=os.getenv("DISCORD_HOME_CHANNEL_NAME", "Hermes #Allgemein"),
+            chat_type="channel",
+            user_id=os.getenv("DISCORD_VOICE_AUTOJOIN_USER_ID", "").strip() or None,
+            user_name=os.getenv("DISCORD_VOICE_AUTOJOIN_USER_NAME", "the user") or "the user",
+            guild_id=str(guild_id),
+        )
+        if hasattr(adapter, "_voice_sources"):
+            adapter._voice_sources[guild_id] = source.to_dict()
+        self._voice_mode[self._voice_key(Platform.DISCORD, str(text_channel_id))] = "all"
+        self._save_voice_modes()
+        self._set_adapter_auto_tts_enabled(adapter, str(text_channel_id), enabled=True)
+        logger.info(
+            "Discord voice autojoin active: guild=%s voice_channel=%s text_channel=%s",
+            guild_id,
