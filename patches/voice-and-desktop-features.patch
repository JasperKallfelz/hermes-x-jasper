+def test_voice_job_runner_is_disabled_by_default(tmp_path, monkeypatch):
+    store = VoiceJobStore(tmp_path / "voice_jobs")
+    job = store.create(prompt="bau mir eine app", source={"platform": "discord"})
+    events = []
+
+    async def notify(message, metadata):
+        events.append((message, metadata))
+
+    def fail_if_cli_is_probed(_name):
+        raise AssertionError("disabled runner must not probe external CLIs")
+
+    monkeypatch.setattr("gateway.voice_jobs.shutil.which", fail_if_cli_is_probed)
+    runner = VoiceJobRunner(store, notify, timeout=1)
+    asyncio.run(runner.run(job.id))
+
+    loaded = store.load(job.id)
+    assert loaded.status == "needs_input"
+    assert "disabled" in loaded.error.lower()
+    assert events[-1][1]["status"] == "needs_input"
+
