+from gateway.voice_domain import (
+    BargeInState,
+    SpeakerPersonaRegistry,
+    VoiceEvent,
+    VoiceEventBus,
+    VoiceEventType,
+)
+
+
+def test_event_bus_emits_transport_neutral_voice_events():
+    seen = []
+    bus = VoiceEventBus()
+    bus.subscribe(seen.append)
+    event = VoiceEvent(VoiceEventType.SPEECH_STARTED, transport="discord", speaker_id="42")
+    bus.publish(event)
+    assert seen == [event]
+
+
+def test_barge_in_requires_sustained_audio_and_only_fires_once_per_turn():
+    state = BargeInState(min_speech_ms=320)
+    assert not state.observe("42", buffered_ms=20, tts_active=True)
+    assert not state.observe("42", buffered_ms=200, tts_active=True)
+    assert state.observe("42", buffered_ms=340, tts_active=True)
+    assert not state.observe("42", buffered_ms=500, tts_active=True)
+    state.complete_turn("42")
+    assert state.observe("42", buffered_ms=340, tts_active=True)
+
+
+def test_barge_in_does_not_arm_when_tts_is_idle():
+    state = BargeInState(min_speech_ms=320)
+    assert not state.observe("42", buffered_ms=500, tts_active=False)
+
+
+def test_persona_registry_resolves_speaker_then_default():
+    registry = SpeakerPersonaRegistry.from_config({
+        "default": {"voice_profile": "seraphina", "voice": "de-DE-SeraphinaMultilingualNeural"},
+        "speakers": {"research": {"voice_profile": "researcher"}},
+    })
+    assert registry.resolve("research").voice_profile == "researcher"
+    assert registry.resolve("research").voice == "de-DE-SeraphinaMultilingualNeural"
+    assert registry.resolve("unknown").voice_profile == "seraphina"
