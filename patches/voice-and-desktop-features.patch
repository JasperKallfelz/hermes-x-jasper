diff --git a/tests/tools/test_tts_runtime_overrides.py b/tests/tools/test_tts_runtime_overrides.py
new file mode 100644
index 000000000..ed00ea8da
--- /dev/null
+++ b/tests/tools/test_tts_runtime_overrides.py
@@ -0,0 +1,34 @@
+"""Runtime-only TTS overrides used by transport speaker personas."""
+
+
+def test_runtime_overrides_are_provider_scoped_and_do_not_mutate_config():
+    from tools.tts_tool import _apply_runtime_tts_overrides
+
+    original = {
+        "provider": "openai",
+        "voice": "global-old",
+        "edge": {"voice": "edge-old", "speed": 1.0},
+    }
+
+    resolved = _apply_runtime_tts_overrides(
+        original,
+        provider="edge",
+        voice="en-US-AriaNeural",
+        model="edge-persona-model",
+        speed=1.15,
+    )
+
+    assert original == {
+        "provider": "openai",
+        "voice": "global-old",
+        "edge": {"voice": "edge-old", "speed": 1.0},
+    }
+    assert resolved["provider"] == "edge"
+    assert resolved["voice"] == "en-US-AriaNeural"
+    assert resolved["model"] == "edge-persona-model"
+    assert resolved["speed"] == 1.15
+    assert resolved["edge"]["voice"] == "en-US-AriaNeural"
+    assert resolved["edge"]["voice_id"] == "en-US-AriaNeural"
+    assert resolved["edge"]["model"] == "edge-persona-model"
+    assert resolved["edge"]["model_id"] == "edge-persona-model"
+    assert resolved["edge"]["speed"] == 1.15
diff --git a/tools/browser_tool.py b/tools/browser_tool.py
index 3332d3a74..c3e413dbd 100644
--- a/tools/browser_tool.py
+++ b/tools/browser_tool.py
@@ -309,6 +309,75 @@ def _get_cdp_override() -> str:
     return ""
 
 
+def _auto_launch_local_cdp_enabled() -> bool:
+    """Whether to auto-launch a local debug Chrome when a loopback ``cdp_url``
+    is configured but not yet listening. This is opt-in via
+    ``BROWSER_TOOL_AUTO_CDP=1`` because it starts a local browser process with
+    a debugging endpoint.
+    """
+    return is_truthy_value(os.getenv("BROWSER_TOOL_AUTO_CDP", ""))
+
+
+def _ensure_local_cdp_ready(cdp_url: str) -> str:
+    """On-demand: if ``cdp_url`` points at a *local loopback* DevTools endpoint
+    that isn't up yet, launch a Hermes-managed debug Chrome (own persistent
+    profile under ~/.hermes/chrome-debug), wait for it, and return a freshly
+    resolved websocket endpoint.
+
+    No-op for remote / non-loopback endpoints (cloud CDP is never launched
+    locally) and when already reachable. Returns the input unchanged on any
+    failure so the caller can surface the original connection error.
+    """
+    if not _auto_launch_local_cdp_enabled():
+        return cdp_url
+    from urllib.parse import urlparse
+
+    parsed = urlparse(cdp_url if "://" in cdp_url else f"http://{cdp_url}")
+    host = (parsed.hostname or "").lower()
+    if host not in {"127.0.0.1", "localhost", "::1"}:
+        return cdp_url
+
+    try:
+        from hermes_cli.browser_connect import (
+            is_browser_debug_ready,
+            try_launch_chrome_debug,
+        )
+    except Exception as e:
+        logger.debug("browser_connect helpers unavailable: %s", e)
+        return cdp_url
+
+    if is_browser_debug_ready(cdp_url, timeout=1.0):
+        return cdp_url
+
+    try:
+        port = parsed.port or 9222
+    except ValueError:
+        port = 9222
+
+    logger.info(
+        "BROWSER_TOOL_AUTO_CDP enabled: auto-launching local debug Chrome on 127.0.0.1:%s",
+        port,
+    )
+    try:
+        launched = try_launch_chrome_debug(port)
+    except Exception as e:
+        logger.warning("Auto-launch of debug Chrome failed: %s", e)
+        launched = False
+
+    if launched:
+        deadline = time.monotonic() + 12.0
+        while time.monotonic() < deadline:
+            if is_browser_debug_ready(cdp_url, timeout=0.05):
+                logger.info("Debug Chrome ready on port %s", port)
+                break
+            time.sleep(0.05)
+        else:
+            logger.warning("Debug Chrome launched but port %s not responding yet", port)
+
+    # Re-resolve so callers get a concrete ws:// endpoint now that Chrome is up.
+    return _resolve_cdp_override(cdp_url)
+
+
 def _get_dialog_policy_config() -> Tuple[str, float]:
     """Read ``browser.dialog_policy`` + ``browser.dialog_timeout_s`` from config.
 
