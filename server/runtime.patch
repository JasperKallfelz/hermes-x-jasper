diff --git a/tests/agent/test_codex_context_recovery.py b/tests/agent/test_codex_context_recovery.py
new file mode 100644
index 00000000000..a05c490302c
--- /dev/null
+++ b/tests/agent/test_codex_context_recovery.py
@@ -0,0 +1,139 @@
+"""A recreated Hermes agent must retain conversation context without duplicating it."""
+
+from types import SimpleNamespace
+
+import pytest
+
+from agent.codex_runtime import run_codex_app_server_turn
+from agent.transports.codex_app_server import CodexAppServerError
+from hermes_state import SessionDB
+
+
+class ContextClient:
+    def __init__(self, threads, requests, resume_error=None):
+        self.threads, self.requests = threads, requests
+        self.resume_error = resume_error
+        self.notes = []
+
+    def initialize(self, **kwargs):
+        return {}
+
+    def request(self, method, params, **kwargs):
+        self.requests.append((method, params))
+        if method == "thread/resume":
+            if self.resume_error:
+                raise self.resume_error
+            return {"thread": {"id": params["threadId"]}}
+        if method == "thread/start":
+            tid = f"thread-{len(self.threads)}"
+            self.threads[tid] = []
+            return {"thread": {"id": tid}}
+        if method == "turn/start":
+            text = params["input"][0]["text"]
+            self.threads[params["threadId"]].append(text)
+            self.notes = [
+                {"method": "item/completed", "params": {"item": {
+                    "type": "userMessage", "id": "u", "content": [{"type": "inputText", "text": text}],
+                }}},
+                {"method": "item/completed", "params": {"item": {
+                    "type": "agentMessage", "id": "a", "text": "answer",
+                }}},
+                {"method": "turn/completed", "params": {"turn": {"id": "turn", "status": "completed"}}},
+            ]
+            return {"turn": {"id": "turn"}}
+        return {}
+
+    def take_notification(self, **kwargs):
+        return self.notes.pop(0) if self.notes else None
+
+    def take_server_request(self, **kwargs):
+        return None
+
+    def is_alive(self):
+        return True
+
+    def stderr_tail(self, *args):
+        return []
+
+    def close(self):
+        pass
+
+
+def agent_for(db, sid):
+    return SimpleNamespace(
+        _session_db=db, session_id=sid, _session_db_created=True,
+        _codex_session=None, session_cwd="/tmp", _skill_nudge_interval=0,
+        valid_tool_names=set(), model="test", provider="openai-codex", base_url="",
+        session_api_calls=0, _interrupt_requested=False,
+        _flush_messages_to_session_db=lambda messages: True,
+    )
+
+
+def run(agent, messages, text):
+    messages.append({"role": "user", "content": text})
+    return run_codex_app_server_turn(
+        agent, user_message=text, original_user_message=text,
+        messages=messages, effective_task_id="test",
+    )
+
+
+@pytest.mark.parametrize("detached", [False, True])
+def test_recreated_agent_recovers_history_once(tmp_path, monkeypatch, detached):
+    import agent.transports.codex_app_server_session as transport
+    threads, requests = {}, []
+    monkeypatch.setattr(transport, "CodexAppServerClient", lambda **kw: ContextClient(threads, requests))
+    db = SessionDB(tmp_path / "state.db")
+    db.create_session(session_id="chat", source="desktop", model="test")
+    history = [{"role": "user", "content": "Measure the ball"},
+               {"role": "assistant", "content": "2311 frames; only pixels/s"}]
+    try:
+        agent = agent_for(db, "chat")
+        assert run(agent, history, "how fast?")["completed"]
+        assert "2311 frames" in threads["thread-0"][0]
+        assert [m["content"] for m in history if m["role"] == "user"] == ["Measure the ball", "how fast?"]
+        agent._codex_session.close()
+        # Reopen the actual DB, as on a backend restart (no in-memory mapping survives).
+        db.close()
+        db = SessionDB(tmp_path / "state.db")
+        agent = agent_for(None if detached else db, "chat")
+        assert run(agent, history, "continue")["completed"]
+        if detached:
+            assert len(threads) == 2  # background reviews share the ID but must never resume the parent
+            assert "2311 frames" in threads["thread-1"][0]
+        else:
+            assert len(threads) == 1
+            assert threads["thread-0"][1] == "continue"
+            assert any(method == "thread/resume" for method, _ in requests)
+        agent._codex_session.close()
+    finally:
+        db.close()
+
+
+@pytest.mark.parametrize("reason", ["missing", "auth", "branch", "rewind"])
+def test_recovery_respects_session_boundaries_and_resume_errors(tmp_path, monkeypatch, reason):
+    import agent.transports.codex_app_server_session as transport
+    threads, requests = {}, []
+    error = None
+    if reason in {"missing", "auth"}:
+        error = CodexAppServerError(code=-32602 if reason == "missing" else -32000,
+                                    message="no rollout found for thread id old" if reason == "missing" else "unauthorized")
+    monkeypatch.setattr(transport, "CodexAppServerClient", lambda **kw: ContextClient(threads, requests, error))
+    db = SessionDB(tmp_path / "state.db")
+    db.create_session(session_id="chat", source="desktop", model="test")
+    db.patch_session_model_config("chat", {"codex_app_server_thread": {
+        "session_id": "parent" if reason == "branch" else "chat", "thread_id": "old",
+        "rewind_count": -1 if reason == "rewind" else 0,
+    }})
+    try:
+        agent = agent_for(db, "chat")
+        history = [{"role": "assistant", "content": "Prior result: pixels/s"}]
+        result = run(agent, history, "continue")
+        assert result["completed"] is (reason != "auth")
+        if reason == "auth":
+            assert not threads  # don't turn credential/transport failures into silent fresh chats
+        else:
+            assert "Prior result: pixels/s" in threads["thread-0"][0]
+        if agent._codex_session:
+            agent._codex_session.close()
+    finally:
+        db.close()
