diff --git a/plugins/platforms/telegram/idle_session.py b/plugins/platforms/telegram/idle_session.py
new file mode 100644
index 00000000000..dd65fc7b7c8
--- /dev/null
+++ b/plugins/platforms/telegram/idle_session.py
@@ -0,0 +1,172 @@
+"""An opt-in, owner-bound /new shortcut after an idle conversational reply."""
+from __future__ import annotations
+
+import asyncio
+from dataclasses import dataclass
+from datetime import datetime
+import logging
+import secrets
+
+from gateway.platforms.event import MessageEvent, MessageType, ProcessingOutcome
+
+logger = logging.getLogger(__name__)
+
+
+@dataclass
+class IdleReply:
+    event: MessageEvent
+    message_id: str = ""
+    token: str = ""
+    shown: bool = False
+    task: asyncio.Task | None = None
+
+
+class TelegramIdleSessionMixin:
+    def _idle_session_seconds(self):
+        extra = getattr(getattr(self, "config", None), "extra", {}) or {}
+        minutes = extra.get("new_session_suggestion_minutes", 0)
+        return minutes * 60 if type(minutes) is int and 1 <= minutes <= 1440 else 0
+
+    def _idle_replies(self):
+        if not hasattr(self, "_telegram_idle_replies"):
+            self._telegram_idle_replies = {}
+            self._telegram_latest_inbound = {}
+        return self._telegram_idle_replies
+
+    @staticmethod
+    def _idle_route(chat_id, thread_id=None):
+        return str(chat_id), str(thread_id or "")
+
+    def _idle_event_allowed(self, event):
+        source = event.source
+        return (self._idle_session_seconds() > 0 and not event.internal
+                and source.chat_type in ("private", "dm")
+                and self._is_sender_authorized(source.user_id, source.chat_type,
+                                              source.chat_id, thread_id=source.thread_id) is True)
+
+    async def _clear_idle_reply(self, route):
+        reply = self._idle_replies().pop(route, None)
+        if reply is None:
+            return
+        if reply.task and reply.task is not asyncio.current_task():
+            reply.task.cancel()
+        if reply.shown and self._bot:
+            try:
+                await self._bot.edit_message_reply_markup(chat_id=route[0],
+                                                         message_id=int(reply.message_id), reply_markup=None)
+            except Exception as exc:
+                logger.debug("Idle session keyboard removal failed: %s", type(exc).__name__)
+
+    async def handle_message(self, event):
+        if self._idle_event_allowed(event):
+            route = self._idle_route(event.source.chat_id, event.source.thread_id)
+            self._idle_replies()
+            self._telegram_latest_inbound[route[0]] = event
+            # Activity anywhere in this DM clears older suggestions, including
+            # clients whose topic ID will only be recovered by the base adapter.
+            for previous_route in list(self._idle_replies()):
+                if previous_route[0] == route[0]:
+                    await self._clear_idle_reply(previous_route)
+        return await super().handle_message(event)
+
+    async def _idle_processing_start(self, event):
+        if not self._idle_event_allowed(event):
+            return
+        route = self._idle_route(event.source.chat_id, event.source.thread_id)
+        self._idle_replies()
+        await self._clear_idle_reply(route)
+        if not event.get_command():
+            self._idle_replies()[route] = IdleReply(event)
+            self._telegram_latest_inbound.setdefault(route[0], event)
+
+    def _remember_idle_message(self, chat_id, metadata, result):
+        if not self._idle_session_seconds() or not result.success or not result.message_id:
+            return
+        route = self._idle_route(chat_id, self._metadata_thread_id(metadata))
+        reply = self._idle_replies().get(route)
+        if reply is not None:
+            ids = (result.raw_response or {}).get("message_ids") if isinstance(result.raw_response, dict) else None
+            reply.message_id = str(ids[-1] if ids else result.message_id)
+
+    async def send(self, chat_id, content, reply_to=None, metadata=None):
+        result = await self._send_telegram_text(chat_id, content, reply_to, metadata)
+        self._remember_idle_message(chat_id, metadata, result)
+        return result
+
+    async def edit_message(self, chat_id, message_id, content, *, finalize=False, metadata=None):
+        result = await self._edit_telegram_message(chat_id, message_id, content, finalize=finalize, metadata=metadata)
+        self._remember_idle_message(chat_id, metadata, result)
+        return result
+
+    async def _idle_processing_complete(self, event, outcome):
+        if not self._idle_event_allowed(event) or event.get_command():
+            return
+        route = self._idle_route(event.source.chat_id, event.source.thread_id)
+        reply = self._idle_replies().get(route)
+        if reply is None or reply.event is not event:
+            return
+        if (outcome != ProcessingOutcome.SUCCESS or not reply.message_id
+                or self._telegram_latest_inbound.get(route[0]) is not event):
+            await self._clear_idle_reply(route)
+            return
+        reply.token = secrets.token_urlsafe(12)
+        reply.task = asyncio.create_task(self._show_idle_new_button(route, reply))
+
+    async def _show_idle_new_button(self, route, reply):
+        from telegram import InlineKeyboardButton, InlineKeyboardMarkup
+        await asyncio.sleep(self._idle_session_seconds())
+        if (self._idle_replies().get(route) is not reply
+                or self._telegram_latest_inbound.get(route[0]) is not reply.event
+                or self._event_session_key(reply.event) in self._active_sessions or not self._bot):
+            return
+        try:
+            # Mark before the RPC so fresh input also removes an in-flight keyboard.
+            reply.shown = True
+            await self._bot.edit_message_reply_markup(
+                chat_id=route[0], message_id=int(reply.message_id),
+                reply_markup=InlineKeyboardMarkup([[InlineKeyboardButton(
+                    "🆕 Neue Sitzung (/new)", callback_data="ns:" + reply.token)]]))
+            if self._idle_replies().get(route) is not reply:
+                await self._bot.edit_message_reply_markup(
+                    chat_id=route[0], message_id=int(reply.message_id), reply_markup=None)
+        except Exception as exc:
+            reply.shown = False
+            logger.warning("Idle session suggestion failed: %s", type(exc).__name__)
+
+    async def _handle_idle_session_callback(self, query, data, cb):
+        if not await self._callback_authorized(query, cb, "Dieser Knopf gehört nicht zu deiner Sitzung."):
+            return
+        route = self._idle_route(cb["chat_id"], cb["thread_id"])
+        reply = self._idle_replies().get(route)
+        if (not reply or not reply.shown or data != "ns:" + reply.token
+                or str(query.from_user.id) != str(reply.event.source.user_id)
+                or str(query.message.message_id) != reply.message_id):
+            await query.answer(text="Dieser Vorschlag ist nicht mehr aktiv. Du kannst /new schreiben.")
+            return
+        if self._event_session_key(reply.event) in self._active_sessions:
+            await query.answer(text="Die Bearbeitung läuft noch. Bitte danach eine neue Sitzung starten.")
+            return
+        # Claim before any await: a repeated tap cannot reset a second, newer session.
+        self._idle_replies().pop(route)
+        await query.answer(text="Neue Sitzung wird gestartet.")
+        try:
+            await query.edit_message_reply_markup(reply_markup=None)
+        except Exception as exc:
+            logger.debug("Idle session keyboard removal failed: %s", type(exc).__name__)
+        # A fresh message during the callback RPCs belongs to newer context.
+        if (self._telegram_latest_inbound.get(route[0]) is not reply.event
+                or self._event_session_key(reply.event) in self._active_sessions):
+            return
+        command = MessageEvent(text="/new", message_type=MessageType.COMMAND, source=reply.event.source,
+                               message_id=str(query.message.message_id), timestamp=datetime.now(),
+                               metadata={"gateway_session_key": self._event_session_key(reply.event)})
+        await self.handle_message(command)
+
+    async def _cancel_idle_session_tasks(self):
+        tasks = [r.task for r in self._idle_replies().values() if r.task and not r.task.done()]
+        for task in tasks:
+            task.cancel()
+        if tasks:
+            await asyncio.gather(*tasks, return_exceptions=True)
+        self._idle_replies().clear()
+        self._telegram_latest_inbound.clear()
