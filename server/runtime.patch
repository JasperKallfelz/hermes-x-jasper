@@ -0,0 +1,169 @@
+"""Idle /new shortcuts follow delivered replies and cannot reset newer context."""
+import asyncio
+from dataclasses import replace
+import sys
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+import pytest
+
+from gateway.config import Platform, PlatformConfig
+from gateway.platforms.event import MessageEvent
+from gateway.session import SessionSource
+from plugins.platforms.telegram import idle_session
+from plugins.platforms.telegram.adapter import TelegramAdapter, _apply_yaml_config
+
+
+@pytest.fixture
+def idle_adapter(monkeypatch):
+    # The shared gateway conftest installs generic telegram stubs. Exercise the
+    # actual keyboard objects/serialization when the connector SDK is installed.
+    for name in list(sys.modules):
+        if name == "telegram" or name.startswith("telegram."):
+            monkeypatch.delitem(sys.modules, name)
+    pytest.importorskip("telegram")
+    clock = SimpleNamespace(started=asyncio.Event(), release=asyncio.Event(), delays=[])
+
+    async def sleep(seconds):
+        clock.delays.append(seconds)
+        clock.started.set()
+        await clock.release.wait()
+
+    # Only the suggestion timer uses the fake clock; gateway tasks keep real asyncio.
+    monkeypatch.setattr(idle_session, "asyncio", SimpleNamespace(
+        sleep=sleep, create_task=asyncio.create_task, current_task=asyncio.current_task, gather=asyncio.gather))
+    extra = _apply_yaml_config({}, {"extra": {"new_session_suggestion_minutes": 20, "rich_messages": False}})
+    adapter = TelegramAdapter(PlatformConfig(enabled=True, token="fake-token", extra=extra))
+    adapter.set_authorization_check(lambda user, *args, **kwargs: user in ("42", "43"))
+    adapter._bot = AsyncMock()
+    ids = iter(range(500, 600))
+    adapter._bot.send_message.side_effect = lambda **kwargs: SimpleNamespace(message_id=next(ids))
+    adapter._start_typing_refresh = lambda *args: None
+    adapter._stop_typing_refresh = AsyncMock()
+    adapter.commands_seen = []
+
+    async def handler(event):
+        adapter.commands_seen.append(event.get_command())
+        return "Antwort " * 800  # Exercise split delivery: button belongs on the last fragment.
+
+    adapter.set_message_handler(handler)
+    event = MessageEvent(text="Hilf mir", message_id="100", source=SessionSource(
+        platform=Platform.TELEGRAM, chat_id="123", chat_type="dm", user_id="42", thread_id="77"))
+    return adapter, clock, event
+
+
+async def process(adapter, event):
+    await adapter.handle_message(event)
+    task = adapter._session_tasks.get(adapter._event_session_key(event))
+    if task:
+        await task
+
+
+async def show_button(adapter, clock, event):
+    await process(adapter, event)
+    await asyncio.wait_for(clock.started.wait(), 5)
+    reply = adapter._idle_replies()[("123", "77")]
+    assert clock.delays == [20 * 60]
+    adapter._bot.edit_message_reply_markup.assert_not_awaited()
+    sends = adapter._bot.send_message.await_count
+    clock.release.set()
+    await reply.task
+    assert adapter._bot.send_message.await_count == sends
+    markup = adapter._bot.edit_message_reply_markup.await_args.kwargs
+    assert str(markup["message_id"]) == reply.message_id
+    assert markup["reply_markup"].inline_keyboard[0][0].callback_data == "ns:" + reply.token
+    return reply
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("case", ["split", "streamed", "input_before", "input_after", "recovered_topic", "failed", "disabled", "internal", "unauthorized"])
+async def test_suggestion_follows_only_the_latest_successful_reply(idle_adapter, case):
+    adapter, clock, event = idle_adapter
+    try:
+        if case == "disabled":
+            adapter.config.extra.pop("new_session_suggestion_minutes")
+        elif case == "internal":
+            event = replace(event, internal=True)
+        elif case == "unauthorized":
+            event = replace(event, source=replace(event.source, user_id="99"))
+        elif case == "failed":
+            adapter.set_message_handler(AsyncMock(side_effect=RuntimeError("turn failed")))
+        elif case == "streamed":
+            async def streamed(inbound):
+                metadata = {"thread_id": "77"}
+                sent = await adapter.send("123", "Entwurf", metadata=metadata)
+                await adapter.edit_message("123", sent.message_id, "Fertige Antwort", finalize=True, metadata=metadata)
+                return None
+            adapter.set_message_handler(streamed)
+
+        if case in ("failed", "disabled", "internal", "unauthorized"):
+            await process(adapter, event)
+            assert not clock.started.is_set()
+            adapter._bot.edit_message_reply_markup.assert_not_awaited()
+        elif case == "input_before":
+            await process(adapter, event)
+            await asyncio.wait_for(clock.started.wait(), 5)
+            old = adapter._idle_replies()[("123", "77")]
+            await process(adapter, replace(event, message_id="101", text="Weiter"))
+            await asyncio.gather(old.task, return_exceptions=True)
+            assert old.task.cancelled()
+            adapter._bot.edit_message_reply_markup.assert_not_awaited()
+        else:
+            reply = await show_button(adapter, clock, event)
+            if case == "split":
+                assert int(reply.message_id) > 500
+            if case in ("input_after", "recovered_topic"):
+                source = event.source
+                if case == "recovered_topic":
+                    source = replace(source, thread_id=None)
+                    adapter._topic_recovery_fn = object()
+                    adapter._apply_topic_recovery = lambda incoming: setattr(incoming.source, "thread_id", "77")
+                await process(adapter, replace(event, source=source, message_id="101", text="Weiter"))
+                calls = adapter._bot.edit_message_reply_markup.await_args_list
+                assert any(c.kwargs["message_id"] == int(reply.message_id)
+                           and c.kwargs["reply_markup"] is None for c in calls)
+    finally:
+        await adapter._cancel_idle_session_tasks()
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("case", ["owner", "duplicate", "outsider", "stale", "wrong_message", "wrong_topic", "busy", "new_input_during_ack"])
+async def test_callback_is_owner_bound_and_never_resets_newer_context(idle_adapter, case):
+    adapter, clock, event = idle_adapter
+    try:
+        reply = await show_button(adapter, clock, event)
+        query = SimpleNamespace(
+            data="ns:" + reply.token,
+            from_user=SimpleNamespace(id=43 if case == "outsider" else 42, first_name="User"),
+            message=SimpleNamespace(chat_id=123, message_id=int(reply.message_id), message_thread_id=77,
+                                    chat=SimpleNamespace(type="private")),
+            answer=AsyncMock(), edit_message_reply_markup=AsyncMock())
+        if case == "stale":
+            await process(adapter, replace(event, message_id="101", text="Weiter"))
+        elif case == "wrong_message":
+            query.message.message_id += 1
+        elif case == "wrong_topic":
+            query.message.message_thread_id = 88
+        elif case == "busy":
+            adapter._active_sessions[adapter._event_session_key(event)] = asyncio.Event()
+        elif case == "new_input_during_ack":
+            async def fresh_input(**kwargs):
+                await process(adapter, replace(event, message_id="101", text="Weiter"))
+            query.answer.side_effect = fresh_input
+
+        update = SimpleNamespace(callback_query=query)
+        if case in ("owner", "duplicate"):
+            # A known callback route must not yield to topic recovery and race
+            # a new input before admitting its /new command.
+            adapter._topic_recovery_fn = object()
+            adapter._apply_topic_recovery = lambda incoming: pytest.fail("callback route was already resolved")
+        await adapter._handle_callback_query(update, None)
+        if case == "duplicate":
+            await adapter._handle_callback_query(update, None)
+        for task in list(adapter._session_tasks.values()):
+            await task
+        assert adapter.commands_seen.count("new") == (1 if case in ("owner", "duplicate") else 0)
+        query.answer.assert_awaited()
+    finally:
+        await adapter._cancel_idle_session_tasks()
+        adapter._active_sessions.clear()
