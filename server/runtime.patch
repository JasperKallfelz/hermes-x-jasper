--- /dev/null
+++ b/tests/agent/test_codex_early_interrupt.py
@@ -0,0 +1,106 @@
+"""Hermes interrupts must cross lazy Codex-session creation without running a prompt."""
+
+import threading
+
+import pytest
+
+from agent import codex_runtime
+from agent.interrupt_control import InterruptControlMixin
+from agent.transports import codex_app_server_session as transport
+
+
+class RecordingClient:
+    def __init__(self):
+        self.requests = []
+        self.notes = []
+
+    def initialize(self, **kwargs):
+        return {}
+
+    def request(self, method, params, **kwargs):
+        self.requests.append((method, params))
+        if method == "thread/start":
+            return {"thread": {"id": "thread"}}
+        if method == "turn/start":
+            self.notes = [{"method": "turn/completed", "params": {
+                "threadId": "thread", "turn": {"id": "turn", "status": "completed"}}}]
+            return {"turn": {"id": "turn"}}
+        return {}
+
+    def take_notification(self, **kwargs):
+        return self.notes.pop(0) if self.notes else None
+
+    def take_server_request(self, **kwargs):
+        return None
+
+    def is_alive(self):
+        return True
+
+    def stderr_tail(self, *args):
+        return []
+
+    def close(self):
+        pass
+
+
+class TestAgent(InterruptControlMixin):
+    __test__ = False
+
+    def __init__(self, cwd):
+        self.api_mode = "codex_app_server"
+        self._codex_session = None
+        self._interrupt_requested = False
+        self._hard_interrupt_requested = threading.Event()
+        self._execution_thread_id = None
+        self._active_children_lock = threading.Lock()
+        self._active_children = []
+        self.quiet_mode = True
+        self._session_db = None
+        self.session_id = "early-codex-stop"
+        self.session_cwd = str(cwd)
+        self._skill_nudge_interval = 0
+        self.valid_tool_names = set()
+        self.model = "test"
+        self.provider = "openai-codex"
+        self.base_url = ""
+        self.session_api_calls = 0
+
+
+def run(agent, text):
+    return codex_runtime.run_codex_app_server_turn(
+        agent, user_message=text, original_user_message=text,
+        messages=[{"role": "user", "content": text}], effective_task_id="test")
+
+
+@pytest.mark.parametrize("stop_at", ["before_creation", "during_creation", "during_initialize"])
+def test_hard_stop_prevents_first_turn_and_does_not_poison_next_turn(tmp_path, monkeypatch, stop_at):
+    agent = TestAgent(tmp_path)
+    client = RecordingClient()
+    monkeypatch.setattr(transport, "CodexAppServerClient", lambda **kw: client)
+    if stop_at == "before_creation":
+        agent.hard_interrupt()
+    elif stop_at == "during_creation":
+        # _load_codex_thread_id executes while the constructor args are being
+        # evaluated, before the new session is published on the agent.
+        def load_thread(_agent):
+            agent.hard_interrupt()
+            return None
+        monkeypatch.setattr(codex_runtime, "_load_codex_thread_id", load_thread)
+    else:
+        def initialize(**kwargs):
+            agent.hard_interrupt()
+            return {}
+        client.initialize = initialize
+    try:
+        result = run(agent, "must not be submitted")
+        assert result["interrupted"] is True
+        assert result["completed"] is False
+        assert not any(method == "turn/start" for method, _ in client.requests)
+        assert agent._interrupt_requested is False
+        assert not agent._hard_interrupt_requested.is_set()
+        assert run(agent, "explicit later request")["completed"] is True
+        assert [params["input"][0]["text"] for method, params in client.requests if method == "turn/start"] == [
+            "explicit later request"]
+    finally:
+        if agent._codex_session:
+            agent._codex_session.close()
