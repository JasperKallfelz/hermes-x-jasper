+def _cancel_unstarted_turn_locked(sid: str, session: dict) -> None:
+    """Settle a startup stop with the same terminal receipt as an interrupted model turn.
+    Caller holds history_lock, so admission cannot clear a stop between this check and reset."""
+    session["running"] = False
+    session["last_active"] = time.time()
