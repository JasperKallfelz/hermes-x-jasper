@@ -0,0 +1,56 @@
+"""A stop acknowledged during startup must not become a new model turn."""
+
+import threading
+from types import SimpleNamespace
+
+import pytest
+
+from tui_gateway import server
+
+
+@pytest.fixture
+def stopped_session(monkeypatch):
+    events = []
+    agent = SimpleNamespace(_interrupt_requested=False, model="test")
+    agent.hard_interrupt = lambda: setattr(agent, "_interrupt_requested", True)
+    agent.clear_interrupt = lambda: setattr(agent, "_interrupt_requested", False)
+    session = {
+        "agent": agent, "session_key": "early-stop", "history_lock": threading.Lock(),
+        "running": True, "history": [], "attached_images": [],
+        "inflight_turn": {"user": "do not execute this cancelled turn"},
+        "_run_thread": SimpleNamespace(is_alive=lambda: True),
+    }
+    monkeypatch.setattr(server, "_emit", lambda kind, sid, payload=None: events.append((kind, payload)))
+    monkeypatch.setattr(server, "_session_uses_compute_host", lambda session, *a: False)
+    monkeypatch.setattr(server, "_ensure_active_session_slot", lambda *a: None)
+    monkeypatch.setattr(server, "_get_usage", lambda agent: {})
+    server._interrupt_session_turn("ui-stop", session)
+    assert agent._interrupt_requested is True
+    return session, events
+
+
+def assert_cancelled(session, events):
+    complete = [payload for kind, payload in events if kind == "message.complete"]
+    assert len(complete) == 1
+    assert complete[0]["status"] == "interrupted"
+    assert session["running"] is False
+    assert session["inflight_turn"] is None
+
+
+def test_stop_between_ready_check_and_admission_is_not_cleared(stopped_session):
+    session, events = stopped_session
+    admitted = server._admit_prompt_turn("ui-stop", session, "do not run", None, None)
+    assert admitted is None
+    assert session["agent"]._interrupt_requested is True
+    assert_cancelled(session, events)
+
+
+@pytest.mark.parametrize("has_agent", [False, True])
