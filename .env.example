# ---------------------------------------------------------------------------
# Hermes CLI Starter — environment template
# ---------------------------------------------------------------------------
# Copy to $HERMES_HOME/.env (default: ~/.hermes/.env) and fill in what you use.
# Every line below is intentionally EMPTY. Never commit a filled-in copy:
# .env is git-ignored, and scripts/audit_public.py will fail the build if a
# real-looking key ever lands in a tracked file.
#
# You do not need all of these. Pick ONE model provider to start.
# ---------------------------------------------------------------------------

# --- Model providers (choose at least one) ---------------------------------
# Nous Research (the upstream project's own API)
NOUS_API_KEY=
# OpenRouter — one key, most models; the easiest way to start
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Any OpenAI-compatible endpoint (local llama.cpp/vLLM/Ollama, etc.)
OPENAI_BASE_URL=

# --- Telegram --------------------------------------------------------------
# From @BotFather: /newbot -> it hands you a token like 123456789:AA...
TELEGRAM_BOT_TOKEN=
# Your own numeric user id (ask @userinfobot). Only these ids may talk to the
# bot — leave the allowlist empty and anyone who finds it can use your agent.
TELEGRAM_ALLOWED_USERS=

# --- Discord ---------------------------------------------------------------
# Discord Developer Portal -> Applications -> Bot -> Reset Token.
# Enable the MESSAGE CONTENT and SERVER MEMBERS privileged intents.
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USERS=
# Optional voice auto-join (this starter's patch). All numeric ids.
DISCORD_VOICE_AUTOJOIN_CHANNEL_ID=
DISCORD_VOICE_AUTOJOIN_TEXT_CHANNEL_ID=
DISCORD_VOICE_AUTOJOIN_GUILD_ID=
# How the agent should address you in spoken greetings (a first name is fine).
DISCORD_VOICE_AUTOJOIN_USER_NAME=

# --- Speech (optional) -----------------------------------------------------
# Only needed for cloud STT/TTS. Edge TTS and local Whisper/Parakeet need none.
ELEVENLABS_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# --- Web / search / images (optional) --------------------------------------
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
REPLICATE_API_TOKEN=
