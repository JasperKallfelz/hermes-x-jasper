diff --git a/.github/workflows/pi-runtime.yml b/.github/workflows/pi-runtime.yml
new file mode 100644
index 0000000000000000000000000000000000000000..939b8917aecdc7a4bf8aae6ecae5f7385fd667b1
--- /dev/null
+++ b/.github/workflows/pi-runtime.yml
@@ -0,0 +1,180 @@
+name: Pi runtime containment
+
+on:
+  workflow_call:
+
+permissions:
+  contents: read
+
+jobs:
+  unit-and-package:
+    name: Unit and wheel gates
+    runs-on: ubuntu-24.04
+    timeout-minutes: 20
+    env:
+      SOURCE_DATE_EPOCH: "1704067200"
+    steps:
+      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2
+      - uses: astral-sh/setup-uv@fac544c07dec837d0ccb6301d7b5580bf5edae39 # 8.2.0
+        with:
+          version: "0.9.28"
+          enable-cache: true
+      - uses: actions/setup-node@1e60f620b9541dca151540d0cbe7c15dc01afc8f # v4.0.4
+        with:
+          node-version: "22.23.2"
+      - name: Fully regenerate and compare the Pi npm lock
+        shell: bash
+        run: |
+          set -euo pipefail
+          npm install --global npm@11.17.0 --ignore-scripts --no-audit --no-fund
+          NPM_CLI="$(npm root --global)/npm/bin/npm-cli.js"
+          python3 agent/transports/pi_assets/verify_npm_lock.py --npm "$NPM_CLI"
+      - name: Set up reviewed Python environment
+        run: |
+          uv python install 3.11.15
+          uv sync --locked --python 3.11.15 --extra dev
+      - name: Run Pi unit and packaging regressions
+        run: scripts/run_pi_release_tests.sh
+      - name: Install Desktop dependencies with exact npm
+        run: npx --yes npm@11.17.0 ci --ignore-scripts
+      - name: Run warning-free Desktop regressions
+        shell: bash
+        run: |
+          set -euo pipefail
+          output=$(cd apps/desktop && NODE_ENV=test ../../node_modules/.bin/vitest run \
+            src/app/session/hooks/use-prompt-actions/index.test.tsx \
+            src/lib/desktop-slash-commands.test.ts 2>&1)
+          printf '%s\n' "$output"
+          if grep -E 'not wrapped in act|Warning:.*act\(|You called act\(|without await' <<<"$output"; then
+            echo "React act warning detected" >&2
+            exit 1
+          fi
+          cd apps/desktop
+          npx --yes npm@11.17.0 run typecheck
+          npx --yes npm@11.17.0 run build
+
+  windows-path-parser:
+    name: Windows drive-letter parser gate
+    runs-on: windows-latest
+    timeout-minutes: 10
+    steps:
+      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2
+      - uses: astral-sh/setup-uv@fac544c07dec837d0ccb6301d7b5580bf5edae39 # 8.2.0
+        with:
+          version: "0.9.28"
+          enable-cache: true
+      - name: Set up reviewed Python environment
+        shell: bash
+        run: |
+          uv python install 3.11.15
+          uv sync --locked --python 3.11.15 --extra dev
+      - name: Run the Windows-only drive-letter assertion without retry or skip
+        shell: bash
+        run: >-
+          scripts/run_tests.sh --file-retries 0 --require-no-skips
+          tests/test_run_tests_parallel.py
+          -k test_drive_letter_colon_is_not_a_path_separator
+
+  docker-containment:
+    name: Clean image and real containment E2E
+    needs: [unit-and-package, windows-path-parser]
+    runs-on: ubuntu-24.04-arm
+    timeout-minutes: 30
+    outputs:
+      image_id: ${{ steps.runtime.outputs.image_id }}
+    steps:
+      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2
+      - uses: astral-sh/setup-uv@fac544c07dec837d0ccb6301d7b5580bf5edae39 # 8.2.0
+        with:
+          version: "0.9.28"
+      - name: Set up test environment
+        run: |
+          uv python install 3.11.15
+          uv sync --locked --python 3.11.15 --extra dev
+      - name: Build from a clean Docker cache and run real E2E
+        id: runtime
+        shell: bash
+        run: |
+          set -euo pipefail
+          IMAGE_ID=$(agent/transports/pi_assets/build-image.sh docker hermes-pi-ci:first | tail -n 1)
+          case "$IMAGE_ID" in sha256:????????????????????????????????????????????????????????????????) ;; *) exit 1 ;; esac
+          SECOND_IMAGE_ID=$(agent/transports/pi_assets/build-image.sh docker hermes-pi-ci:second | tail -n 1)
+          case "$SECOND_IMAGE_ID" in sha256:????????????????????????????????????????????????????????????????) ;; *) exit 1 ;; esac
+          if [ "$IMAGE_ID" != "$SECOND_IMAGE_ID" ]; then
+            echo "Clean Pi image builds were not reproducible" >&2
+            exit 1
+          fi
+          echo "image_id=$IMAGE_ID" >> "$GITHUB_OUTPUT"
+          HERMES_TEST_PI_IMAGE="$IMAGE_ID" scripts/run_pi_release_tests.sh --docker
+
+      # Evidence is generated only after the two image IDs compare equal. It is
+      # captured from the immutable image and uploaded beside (never inside)
+      # the runtime, so timestamps and signatures cannot alter the reviewed ID.
+      - name: Generate complete post-merge SBOM and source provenance
+        if: github.event_name == 'push' && github.ref == 'refs/heads/main'
+        shell: bash
+        env:
+          RUNTIME_IMAGE_ID: ${{ steps.runtime.outputs.image_id }}
+          SOURCE_REPOSITORY: ${{ github.repository }}
+          SOURCE_REVISION: ${{ github.sha }}
+          SOURCE_REF: ${{ github.ref }}
+          WORKFLOW_RUN_ID: ${{ github.run_id }}
+          WORKFLOW_RUN_ATTEMPT: ${{ github.run_attempt }}
+        run: |
+          set -euo pipefail
+          evidence_dir=pi-runtime-evidence
+          mkdir -p "$evidence_dir"
+          docker image inspect "$RUNTIME_IMAGE_ID" > "$evidence_dir/image-inspect.json"
+          docker version --format '{{json .}}' > "$evidence_dir/docker-version.json"
+          docker buildx version > "$evidence_dir/buildkit-version.txt"
+          docker run --rm --read-only --network none --cap-drop ALL \
+            --security-opt no-new-privileges --entrypoint dpkg-query "$RUNTIME_IMAGE_ID" \
+            -W '-f=${Package}\t${Version}\t${Architecture}\n' \
+            > "$evidence_dir/dpkg-packages.tsv"
+          image_run() {
+            docker run --rm --read-only --network none --cap-drop ALL \
+              --security-opt no-new-privileges --entrypoint "$1" \
+              "$RUNTIME_IMAGE_ID" "${@:2}"
+          }
+          image_run cat /opt/hermes/pi-build/package-lock.json \
+            > "$evidence_dir/package-lock.json"
+          image_run cat /opt/hermes/pi-build/verification-requirements.txt \
+            > "$evidence_dir/verification-requirements.txt"
+          image_run uv pip list --python /opt/hermes/verify-venv/bin/python --format json \
+            > "$evidence_dir/verify-python-packages.json"
+          image_run node --version > "$evidence_dir/node-version.txt"
+          image_run npm --version > "$evidence_dir/npm-version.txt"
+          image_run python3 --version > "$evidence_dir/python-version.txt"
+          image_run uv --version > "$evidence_dir/uv-version.txt"
+          python3 scripts/generate_pi_runtime_evidence.py --evidence-dir "$evidence_dir"
+
+      - name: Upload post-merge SBOM and source provenance
+        if: github.event_name == 'push' && github.ref == 'refs/heads/main'
+        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
+        with:
+          name: pi-runtime-sbom-provenance-${{ github.sha }}
+          path: pi-runtime-evidence/
+          if-no-files-found: error
+          retention-days: 30
+
+  trusted-provenance-attestation:
+    name: Trusted GitHub build-provenance attestation
+    needs: docker-containment
+    if: github.event_name == 'push' && github.ref == 'refs/heads/main'
+    runs-on: ubuntu-24.04
+    timeout-minutes: 10
+    permissions:
+      contents: read
+      id-token: write
+      attestations: write
+    steps:
+      - name: Download immutable-image evidence
+        uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
+        with:
+          name: pi-runtime-sbom-provenance-${{ github.sha }}
+          path: pi-runtime-evidence
+      - name: Attest immutable runtime build provenance
+        uses: actions/attest-build-provenance@a2bbfa25375fe432b6a289bc6b6cd05ecd0c4c32 # v4.1.0
+        with:
+          subject-name: hermes-pi-runtime
+          subject-digest: ${{ needs.docker-containment.outputs.image_id }}
