index 0000000000000000000000000000000000000000..df0967eadddebb9a12a5ce41a4a686068335aaa0
--- /dev/null
+++ b/agent/transports/pi_assets/build-image.sh
@@ -0,0 +1,82 @@
+#!/bin/sh
+set -eu
+
+docker_bin=${1:-docker}
+image_tag=${2:-hermes-pi:0.84.3}
+script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+source_date_epoch=1704067200
+target_platform=linux/arm64
+
+# A docker exporter with timestamp rewriting cannot also use the docker
+# driver's implicit unpack path. Export to a private archive, load it through
+# the caller-selected CLI, and discard it on success, error, or interruption.
+# The load command's output is informational and is never an image identity.
+umask 077
+archive_dir=$(mktemp -d "${TMPDIR:-/tmp}/hermes-pi-image.XXXXXX")
+image_archive=$archive_dir/runtime-image.tar
+cleanup_archive() {
+  rm -f -- "$image_archive"
+  rmdir -- "$archive_dir" 2>/dev/null || true
+}
+trap cleanup_archive 0
+trap 'exit 129' HUP
+trap 'exit 130' INT
+trap 'exit 143' TERM
+chmod 0700 "$archive_dir"
+
+# The runtime ID is a release contract: identical reviewed inputs must produce
+# the same local image ID. BuildKit rewrites every exported layer timestamp to
+# this fixed epoch, while the build arg exposes the same value to npm/uv and
+# any other package step. Provenance/SBOM evidence is generated separately in
+# post-merge CI so timestamped attestations never change this runtime ID.
+SOURCE_DATE_EPOCH=$source_date_epoch DOCKER_BUILDKIT=1 "$docker_bin" buildx build \
+  --pull=false \
+  --no-cache \
+  --platform "$target_platform" \
+  --build-arg "SOURCE_DATE_EPOCH=$source_date_epoch" \
+  --provenance=false \
+  --output "type=docker,dest=$image_archive,rewrite-timestamp=true" \
+  --tag "$image_tag" \
+  --file "$script_dir/Dockerfile" \
+  "$script_dir"
+
+# BuildKit creates this file under the private directory; pin its permissions
+# before handing it to Docker and reject missing/empty exporter output.
+test -f "$image_archive"
+test -s "$image_archive"
+chmod 0600 "$image_archive"
+"$docker_bin" load --input "$image_archive" >/dev/null
+
+# Resolve the caller's exact requested tag after loading, then use only that
+# immutable ID for every subsequent inspection and execution. In particular,
+# do not parse or trust implementation-specific `docker load` output.
+image_id=$("$docker_bin" image inspect --format '{{.Id}}' "$image_tag")
+case "$image_id" in
+  sha256:????????????????????????????????????????????????????????????????) ;;
+  *)
+    echo "Docker returned a non-immutable image ID: $image_id" >&2
+    exit 1
+    ;;
+esac
+
+declared_version=$(
+  "$docker_bin" image inspect \
+    --format '{{index .Config.Labels "org.hermes.pi.version"}}' \
+    "$image_id"
+)
+if [ "$declared_version" != "0.84.3" ]; then
+  echo "Built image has the wrong org.hermes.pi.version label" >&2
+  exit 1
+fi
+
+reported_version=$(
+  "$docker_bin" run --rm --network none --entrypoint pi "$image_id" --version
+)
+if [ "$reported_version" != "0.84.3" ]; then
+  echo "Built image executed an unexpected Pi version" >&2
+  exit 1
+fi
+
+echo "Built and inspected $image_tag"
+echo "Configure this immutable local image ID: $image_id"
+printf '%s\n' "$image_id"
diff --git a/agent/transports/pi_assets/egress_proxy.py b/agent/transports/pi_assets/egress_proxy.py
new file mode 100644
index 0000000000000000000000000000000000000000..ce85c9cb9d680d83099aab20611202072211748a
--- /dev/null
+++ b/agent/transports/pi_assets/egress_proxy.py
@@ -0,0 +1,325 @@
+#!/usr/bin/env python3
+"""Small destination-allowlisting HTTP CONNECT proxy for managed Pi containers."""
+from __future__ import annotations
+
+import ipaddress
+import io
+import os
+import re
+import select
+import socket
+import socketserver
+from typing import BinaryIO
+
+MAX_HEADERS = 64 * 1024
+MAX_CLIENT_HELLO = 128 * 1024
+ALLOW_PRIVATE = os.environ.get("HERMES_PI_PROXY_TEST_ALLOW_PRIVATE") == "1"
+_HEADER_NAME = re.compile(rb"^[!#$%&'*+.^_`|~0-9A-Za-z-]+$")
+_HOP_BY_HOP_HEADERS = frozenset({
+    b"connection",
+    b"keep-alive",
+    b"proxy-authenticate",
+    b"proxy-authorization",
+    b"proxy-connection",
+    b"te",
+    b"trailer",
+    b"transfer-encoding",
+    b"upgrade",
+})
+
+
+def _allowed_destinations() -> set[tuple[str, int]]:
+    result: set[tuple[str, int]] = set()
+    for raw in os.environ.get("HERMES_PI_PROXY_ALLOWLIST", "").split(","):
+        value = raw.strip().lower()
+        if not value:
+            continue
+        if value.count(":") == 1:
+            host, raw_port = value.rsplit(":", 1)
+            port = int(raw_port)
+        else:
+            host, port = value, 443
+        result.add((host.rstrip("."), port))
+    return result
+
+
+ALLOWLIST = _allowed_destinations()
+
+
+def _read_exact(stream: BinaryIO | io.BufferedIOBase, length: int) -> bytes:
+    chunks = bytearray()
+    while len(chunks) < length:
+        chunk = stream.read(length - len(chunks))
+        if not chunk:
+            raise ValueError("truncated TLS ClientHello")
+        chunks.extend(chunk)
+    return bytes(chunks)
+
+
+def _take(data: bytes, offset: int, length: int) -> tuple[bytes, int]:
+    end = offset + length
+    if length < 0 or end > len(data):
+        raise ValueError("malformed TLS ClientHello")
+    return data[offset:end], end
+
+
+def _parse_client_hello_sni(payload: bytes) -> str:
+    if len(payload) < 34:
+        raise ValueError("malformed TLS ClientHello")
+    offset = 34  # legacy_version + random
+    session_length = payload[offset]
+    _, offset = _take(payload, offset + 1, session_length)
+    cipher_length_raw, offset = _take(payload, offset, 2)
+    cipher_length = int.from_bytes(cipher_length_raw, "big")
+    if cipher_length < 2 or cipher_length % 2:
+        raise ValueError("malformed TLS cipher list")
+    _, offset = _take(payload, offset, cipher_length)
+    compression_length_raw, offset = _take(payload, offset, 1)
+    compression_length = compression_length_raw[0]
+    if compression_length < 1:
+        raise ValueError("malformed TLS compression list")
+    _, offset = _take(payload, offset, compression_length)
+    extensions_length_raw, offset = _take(payload, offset, 2)
+    extensions_length = int.from_bytes(extensions_length_raw, "big")
+    extensions, offset = _take(payload, offset, extensions_length)
+    if offset != len(payload):
+        raise ValueError("malformed TLS ClientHello length")
+
+    sni: str | None = None
+    ext_offset = 0
+    while ext_offset < len(extensions):
+        header, ext_offset = _take(extensions, ext_offset, 4)
+        extension_type = int.from_bytes(header[:2], "big")
+        extension_length = int.from_bytes(header[2:], "big")
+        extension, ext_offset = _take(extensions, ext_offset, extension_length)
+        # ECH can conceal the effective destination. This proxy has no ECH
+        # termination key, so both assigned and draft code points fail closed.
+        if extension_type in {0xFE0D, 0xFFCE}:
+            raise ValueError("encrypted ClientHello is not supported")
+        if extension_type != 0:
+            continue
+        if sni is not None or len(extension) < 5:
+            raise ValueError("malformed or duplicate TLS SNI extension")
+        names_length = int.from_bytes(extension[:2], "big")
+        if names_length != len(extension) - 2:
+            raise ValueError("malformed TLS SNI list")
+        name_offset = 2
+        names: list[str] = []
+        while name_offset < len(extension):
+            name_type = extension[name_offset]
+            raw_length, name_offset = _take(extension, name_offset + 1, 2)
+            name_length = int.from_bytes(raw_length, "big")
+            raw_name, name_offset = _take(extension, name_offset, name_length)
+            if name_type != 0:
+                raise ValueError("unknown TLS server-name type")
+            try:
+                names.append(raw_name.decode("ascii").lower())
+            except UnicodeDecodeError as exc:
+                raise ValueError("non-ASCII TLS SNI") from exc
+        if len(names) != 1 or not names[0] or names[0].endswith("."):
+            raise ValueError("TLS ClientHello must contain one exact DNS SNI")
+        sni = names[0]
+    if ext_offset != len(extensions) or sni is None:
+        raise ValueError("TLS ClientHello has no usable SNI")
+    return sni
+
+
+def _read_client_hello(stream: BinaryIO | io.BufferedIOBase) -> tuple[str, bytes]:
+    records = bytearray()
+    handshake = bytearray()
+    expected_handshake_length: int | None = None
+    while len(records) < MAX_CLIENT_HELLO:
+        header = _read_exact(stream, 5)
+        content_type = header[0]
+        legacy_version = header[1:3]
+        record_length = int.from_bytes(header[3:], "big")
+        if content_type != 22 or legacy_version[0] != 3 or not (1 <= record_length <= 65535):
+            raise ValueError("CONNECT tunnel requires a TLS ClientHello")
+        body = _read_exact(stream, record_length)
+        records.extend(header)
+        records.extend(body)
+        handshake.extend(body)
+        if len(records) > MAX_CLIENT_HELLO:
+            raise ValueError("TLS ClientHello exceeds proxy limit")
+        if expected_handshake_length is None and len(handshake) >= 4:
+            if handshake[0] != 1:
+                raise ValueError("first TLS handshake message is not ClientHello")
+            expected_handshake_length = 4 + int.from_bytes(handshake[1:4], "big")
+            if expected_handshake_length > MAX_CLIENT_HELLO:
+                raise ValueError("TLS ClientHello exceeds proxy limit")
+        if expected_handshake_length is not None and len(handshake) >= expected_handshake_length:
+            if len(handshake) != expected_handshake_length:
+                raise ValueError("unexpected TLS handshake data before SNI validation")
+            return _parse_client_hello_sni(bytes(handshake[4:])), bytes(records)
+    raise ValueError("TLS ClientHello exceeds proxy limit")
+
+
+def _resolve(host: str, port: int) -> list[tuple]:
+    rows = socket.getaddrinfo(host, port, type=socket.SOCK_STREAM)
+    if not rows:
+        raise OSError("destination did not resolve")
+    if not ALLOW_PRIVATE:
+        for row in rows:
+            address = ipaddress.ip_address(row[4][0])
+            if not address.is_global:
+                raise OSError("non-public destination address denied")
+    return rows
+
+
+def _parse_authority(authority: str, default_port: int) -> tuple[str, int]:
+    if "@" in authority or authority.startswith("["):
+        raise ValueError("invalid destination authority")
+    if authority.count(":") == 1:
+        host, raw_port = authority.rsplit(":", 1)
+        port = int(raw_port)
+    elif ":" in authority:
+        raise ValueError("IP literals are not permitted")
+    else:
+        host, port = authority, default_port
+    host = host.strip().lower().rstrip(".")
+    if not host or "*" in host or not (1 <= port <= 65535):
+        raise ValueError("invalid destination")
+    try:
+        ipaddress.ip_address(host)
+    except ValueError:
+        pass
+    else:
+        raise ValueError("IP literal destinations are not permitted")
+    if (host, port) not in ALLOWLIST:
+        raise PermissionError("destination is not allowlisted")
+    return host, port
+
+
+class ProxyHandler(socketserver.StreamRequestHandler):
+    timeout = 30
+    rbufsize = 0
+
+    def _error(self, code: int, message: str) -> None:
+        body = (message + "\n").encode("utf-8", errors="replace")[:1024]
+        self.wfile.write(
+            f"HTTP/1.1 {code} Denied\r\nConnection: close\r\nContent-Length: {len(body)}\r\n\r\n".encode()
+            + body
+        )
+
+    def _headers(self) -> tuple[str, list[tuple[bytes, bytes]]]:
+        first = self.rfile.readline(MAX_HEADERS + 1)
+        if not first or len(first) > MAX_HEADERS or not first.endswith(b"\r\n"):
+            raise ValueError("request line too large")
+        total = len(first)
+        headers: list[tuple[bytes, bytes]] = []
+        while True:
+            line = self.rfile.readline(MAX_HEADERS - total + 1)
+            total += len(line)
+            if not line or total > MAX_HEADERS:
+                raise ValueError("headers too large")
+            if line == b"\r\n":
+                break
+            if not line.endswith(b"\r\n") or line[:1] in {b" ", b"\t"}:
+                raise ValueError("malformed HTTP header")
+            raw = line[:-2]
+            if b":" not in raw:
+                raise ValueError("malformed HTTP header")
+            name, value = raw.split(b":", 1)
+            if not _HEADER_NAME.fullmatch(name):
+                raise ValueError("malformed HTTP header name")
+            value = value.strip(b" \t")
+            if any(byte < 32 and byte != 9 for byte in value) or 127 in value:
+                raise ValueError("malformed HTTP header value")
+            headers.append((name.lower(), value))
+        return first.decode("iso-8859-1").rstrip("\r\n"), headers
+
+    @staticmethod
+    def _forward_headers(
+        headers: list[tuple[bytes, bytes]], canonical_host: str,
+    ) -> list[bytes]:
+        host_values = [value for name, value in headers if name == b"host"]
+        if len(host_values) > 1 or any(not value for value in host_values):
+            raise ValueError("malformed or duplicate Host header")
+        connection_tokens: set[bytes] = set()
+        for name, value in headers:
+            if name != b"connection":
+                continue
+            for raw_token in value.split(b","):
+                token = raw_token.strip().lower()
+                if not token or not _HEADER_NAME.fullmatch(token):
+                    raise ValueError("malformed Connection header")
+                connection_tokens.add(token)
+        denied = _HOP_BY_HOP_HEADERS | connection_tokens | {b"host"}
+        forwarded = [
+            name + b": " + value + b"\r\n"
+            for name, value in headers
+            if name not in denied
+        ]
+        return [f"Host: {canonical_host}\r\n".encode("ascii"), *forwarded]
+
+    @staticmethod
+    def _connect(host: str, port: int) -> socket.socket:
+        last: OSError | None = None
+        for family, socktype, proto, _canon, sockaddr in _resolve(host, port):
+            upstream = socket.socket(family, socktype, proto)
+            upstream.settimeout(20)
+            try:
+                upstream.connect(sockaddr)
+                return upstream
+            except OSError as exc:
+                last = exc
+                upstream.close()
+        raise last or OSError("could not connect")
+
+    def _relay(self, upstream: socket.socket) -> None:
+        peers = [self.connection, upstream]
+        while True:
+            readable, _, _ = select.select(peers, [], [], 60)
+            if not readable:
+                return
+            for source in readable:
+                data = source.recv(64 * 1024)
+                if not data:
+                    return
+                target = upstream if source is self.connection else self.connection
+                target.sendall(data)
+
+    def handle(self) -> None:
+        try:
+            request_line, headers = self._headers()
+            method, target, version = request_line.split(" ", 2)
+            if not _HEADER_NAME.fullmatch(method.encode("ascii")) or version not in {
+                "HTTP/1.0", "HTTP/1.1",
+            }:
+                raise ValueError("malformed HTTP request line")
+            if method.upper() == "CONNECT":
+                host, port = _parse_authority(target, 443)
+                self.wfile.write(b"HTTP/1.1 200 Connection Established\r\n\r\n")
+                self.wfile.flush()
+                sni, client_hello = _read_client_hello(self.rfile)
+                if sni != host:
+                    raise PermissionError("TLS SNI does not match CONNECT authority")
+                upstream = self._connect(host, port)
+                try:
+                    upstream.sendall(client_hello)
+                    self._relay(upstream)
+                finally:
+                    upstream.close()
+                return
+
+            # Pi's reviewed runtime traffic is HTTPS.  Plaintext proxying is
+            # deliberately unsupported: forwarding even one framed request
+            # while relaying the connection would let pipelined bytes bypass
+            # destination validation.
+            raise PermissionError("plaintext HTTP proxying is not supported")
+        except PermissionError as exc:
+            self._error(403, str(exc))
+        except Exception:
+            self._error(502, "proxy request rejected")
+
+
+class Server(socketserver.ThreadingMixIn, socketserver.TCPServer):
+    allow_reuse_address = True
+    daemon_threads = True
+
+
+if __name__ == "__main__":
+    if not ALLOWLIST:
+        raise SystemExit("HERMES_PI_PROXY_ALLOWLIST must not be empty")
+    with Server(("0.0.0.0", 8080), ProxyHandler) as server:
+        server.serve_forever()
diff --git a/agent/transports/pi_assets/hermes_bridge.ts b/agent/transports/pi_assets/hermes_bridge.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4883138e2a8c89c4e9acf27ed870c5f52ce3af7d
--- /dev/null
+++ b/agent/transports/pi_assets/hermes_bridge.ts
@@ -0,0 +1,99 @@
+/**
+ * Hermes-owned policy/approval extension for Pi 0.84.3.
+ *
+ * This is defense in depth, not containment. Write-capable sessions run the
+ * entire Pi process inside the separately enforced Docker boundary.
+ */
+import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";
+import { lstatSync, readlinkSync, realpathSync } from "node:fs";
+import { dirname, isAbsolute, parse, relative, resolve, sep } from "node:path";
+
+const WORKSPACE = process.env.HERMES_PI_WORKSPACE || process.cwd();
+const WORKSPACE_REAL = realpathSync(WORKSPACE);
+const WORKSPACE_GIT = resolve(WORKSPACE_REAL, ".git");
+
+function resolveSymlinks(candidate: string, followed = 0): string {
+  if (followed > 40) throw new Error("too many symbolic links in mediated path");
+  const absolute = resolve(candidate);
+  const root = parse(absolute).root;
+  const tail = relative(root, absolute);
+  const parts = tail ? tail.split(sep).filter(Boolean) : [];
+  let current = root;
+  for (let index = 0; index < parts.length; index += 1) {
+    const next = resolve(current, parts[index]);
+    try {
+      const metadata = lstatSync(next);
+      if (metadata.isSymbolicLink()) {
+        const link = readlinkSync(next);
+        const target = resolve(dirname(next), link, ...parts.slice(index + 1));
+        return resolveSymlinks(target, followed + 1);
+      }
+      current = next;
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error;
+      // The existing prefix is already canonical. Resolve the absent suffix
+      // from it so dangling leaf and parent symlinks cannot hide traversal.
+      return resolve(current, ...parts.slice(index));
+    }
+  }
+  return current;
+}
+
+function mediatedRealpath(candidate: string): string {
+  return resolveSymlinks(resolve(WORKSPACE_REAL, candidate));
+}
+
+function isSameOrDescendant(root: string, candidate: string): boolean {
+  const rel = relative(root, candidate);
+  return rel === "" || (!rel.startsWith("..") && !isAbsolute(rel));
+}
+
+export function canonicalInside(candidate: string): boolean {
+  const lexical = resolve(WORKSPACE_REAL, candidate);
+  if (!isSameOrDescendant(WORKSPACE_REAL, lexical)) return false;
+  // Deny the linked-worktree pointer itself and every lexical descendant
+  // before following symlinks. A .git file is host control-plane metadata,
+  // not project content, and disclosing it exposes the common-worktree path.
+  if (isSameOrDescendant(WORKSPACE_GIT, lexical)) return false;
+  try {
+    const canonical = mediatedRealpath(candidate);
+    if (!isSameOrDescendant(WORKSPACE_REAL, canonical)) return false;
+    // An ordinary in-workspace symlink may alias .git. Compare the resolved
+    // target too, so aliases cannot read, edit, or overwrite the pointer.
+    const gitCanonical = resolveSymlinks(WORKSPACE_GIT);
+    return !isSameOrDescendant(gitCanonical, canonical);
+  } catch {
+    // ENOTDIR and malformed/symlink-loop cases are denied, never delegated to
+    // a tool implementation whose path semantics could differ.
+    return false;
+  }
+}
+
+function pathArguments(input: Record<string, unknown>): string[] {
+  return [input.path, input.file, input.directory, input.cwd]
+    .filter((value): value is string => typeof value === "string" && value.length > 0);
+}
+
+export default function hermesBridge(pi: ExtensionAPI) {
+  pi.on("project_trust", async () => ({ trusted: "no", remember: false }));
+
+  pi.on("before_agent_start", async event => ({
+    systemPrompt:
+      event.systemPrompt +
+      "\n\nHermes owns workspace assignment, approvals, and final verification. " +
+      "Stay inside the assigned workspace. Never invoke coding_task recursively. " +
+      "This extension is policy mediation; the Docker runtime is the containment boundary."
+  }));
+
+  pi.on("tool_call", async event => {
+    const input = (event.input || {}) as Record<string, unknown>;
+    for (const candidate of pathArguments(input)) {
+      if (!canonicalInside(candidate)) {
+        return { block: true, reason: "Path is outside the Hermes-assigned workspace", terminate: true };
+      }
+    }
+    if (event.toolName === "bash" || event.toolName === "powershell") {
+      return { block: true, reason: "Model shell tools are disabled by Hermes", terminate: true };
+    }
+  });
+}
