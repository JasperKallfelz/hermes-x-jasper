#!/usr/bin/env bash
# Thin portability launcher; all stateful work lives in the Python 3.11 runtime.
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
PYTHON_BIN="${HERMES_DEEP_CHAT_PYTHON:-}"
if [[ -z "$PYTHON_BIN" ]]; then
  PYTHON_BIN="$(command -v python3.11 || command -v python3 || true)"
fi
if [[ -z "$PYTHON_BIN" || "$PYTHON_BIN" != /* || ! -f "$PYTHON_BIN" || ! -x "$PYTHON_BIN" ]]; then
  echo "hermes-deep-chat: Python 3.11+ is unavailable" >&2
  exit 75
fi
if ! "$PYTHON_BIN" -I -S -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)'; then
  echo "hermes-deep-chat: Python 3.11 or newer is required" >&2
  exit 75
fi

RUNTIME="$SCRIPT_DIR/deep_chat_bridge.py"
if [[ ! -f "$RUNTIME" ]]; then
  raw_home="${HERMES_HOME:-${HOME:-}/.hermes}"
  [[ -n "$raw_home" && "$raw_home" == /* ]] || {
    echo "hermes-deep-chat: HERMES_HOME/HOME must resolve to an absolute path" >&2
    exit 64
  }
  RUNTIME="$raw_home/bin/deep_chat_bridge.py"
fi
[[ "$RUNTIME" == /* && -f "$RUNTIME" ]] || {
  echo "hermes-deep-chat: maintained runtime is unavailable" >&2
  exit 70
}

exec "$PYTHON_BIN" -B "$RUNTIME" "$@"
