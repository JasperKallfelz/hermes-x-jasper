CODEX_HOME_POINTER_LIMIT = 4096


def _owned_private_regular(info: os.stat_result) -> bool:
    owner_ok = not hasattr(os, "geteuid") or info.st_uid == os.geteuid()
    return stat.S_ISREG(info.st_mode) and owner_ok and not (info.st_mode & 0o077)


def _secure_pointer_text(path: Path) -> Optional[str]:
    """Read one private pointer without following or blocking on special files."""
    try:
        before = os.lstat(path)
        if not _owned_private_regular(before) or before.st_size > CODEX_HOME_POINTER_LIMIT:
            return None
        flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NONBLOCK", 0)
        if hasattr(os, "O_NOFOLLOW"):
            flags |= os.O_NOFOLLOW
        fd = os.open(path, flags)
        try:
            after = os.fstat(fd)
            if (
                not _owned_private_regular(after)
                or (before.st_dev, before.st_ino) != (after.st_dev, after.st_ino)
            ):
                return None
            payload = os.read(fd, CODEX_HOME_POINTER_LIMIT + 1)
            if len(payload) > CODEX_HOME_POINTER_LIMIT:
                return None
        finally:
            os.close(fd)
        return payload.decode("utf-8").strip()
    except (OSError, UnicodeError, ValueError):
        return None


def _safe_codex_home(raw: str, home: Path) -> Optional[Path]:
    if not raw or not os.path.isabs(raw):
        return None
    try:
        candidate = Path(raw).resolve(strict=True)
        candidate.relative_to(home)
        directory_info = candidate.stat()
        if (
            not stat.S_ISDIR(directory_info.st_mode)
            or (hasattr(os, "geteuid") and directory_info.st_uid != os.geteuid())
            or directory_info.st_mode & 0o077
        ):
            return None
        auth_path = candidate / "auth.json"
        auth_before = os.lstat(auth_path)
        if not _owned_private_regular(auth_before):
            return None
        flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NONBLOCK", 0)
        if hasattr(os, "O_NOFOLLOW"):
            flags |= os.O_NOFOLLOW
        fd = os.open(auth_path, flags)
        try:
            auth_after = os.fstat(fd)
            if (
                not _owned_private_regular(auth_after)
                or (auth_before.st_dev, auth_before.st_ino)
                != (auth_after.st_dev, auth_after.st_ino)
            ):
                return None
        finally:
            os.close(fd)
        return candidate
    except (OSError, RuntimeError, ValueError):
        return None


def configure_active_codex_home() -> None:
    """Resolve CODEX_HOME once from a private absolute pointer."""
    try:
        home = Path.home().resolve(strict=True)
    except (OSError, RuntimeError):
        os.environ.pop("CODEX_HOME", None)
        return
    configured = os.environ.get("CODEX_HOME")
    if configured is None:
        configured = _secure_pointer_text(home / ".codex-active-home")
    candidate = _safe_codex_home(configured or "", home)
    if candidate is None:
        os.environ.pop("CODEX_HOME", None)
        return
    os.environ["CODEX_HOME"] = str(candidate)


configure_active_codex_home()

