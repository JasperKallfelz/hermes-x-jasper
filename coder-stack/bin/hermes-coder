class TailBuffer:
    """Thread-safe bounded byte tail."""

    def __init__(self, limit: int) -> None:
        self.limit = limit
        self.parts = deque()  # type: Deque[bytes]
        self.size = 0
        self.lock = threading.Lock()

    def append(self, chunk: bytes) -> None:
        if not chunk:
            return
        with self.lock:
            self.parts.append(chunk)
            self.size += len(chunk)
            while self.size > self.limit and self.parts:
                excess = self.size - self.limit
                first = self.parts[0]
                if len(first) <= excess:
                    self.parts.popleft()
                    self.size -= len(first)
                else:
                    self.parts[0] = first[excess:]
                    self.size -= excess

    def value(self) -> bytes:
        with self.lock:
            return b"".join(self.parts)


class BoundedCapture:
    """Retain a complete bounded stream and flag the first excess byte."""

    def __init__(self, limit: int, overflow: threading.Event) -> None:
        self.limit = limit
        self.overflow = overflow
        self.payload = bytearray()
        self.lock = threading.Lock()

    def append(self, chunk: bytes) -> None:
        if not chunk:
            return
        with self.lock:
            available = self.limit - len(self.payload)
            if available > 0:
                self.payload.extend(chunk[:available])
            if len(chunk) > available:
                self.overflow.set()

    def value(self) -> bytes:
        with self.lock:
            return bytes(self.payload)


class CodexFinalOutputParser:
    """Incrementally isolate the last completed Codex agent message."""

    def __init__(self) -> None:
        self.total = 0
        self.pending = bytearray()
        self.final_output = None  # type: Optional[bytes]
        self.error = None  # type: Optional[str]
        self.saw_error_event = False

    def _fail(self, reason: str) -> None:
        if self.error is None:
            self.error = reason
        self.pending.clear()
        self.final_output = None

    def feed(self, chunk: bytes) -> None:
        if not chunk or self.error is not None:
            return
        self.total += len(chunk)
        if self.total > FINAL_NATIVE_STREAM_LIMIT:
            self._fail("final_output_oversized")
            return
        self.pending.extend(chunk)
        while True:
            newline = self.pending.find(b"\n")
            if newline < 0:
                break
            line = bytes(self.pending[:newline])
            del self.pending[:newline + 1]
            self._parse_line(line)
            if self.error is not None:
                return

    def _parse_line(self, line: bytes) -> None:
        if not line.strip():
            return
        try:
            event = json.loads(
                line.decode("utf-8"), object_pairs_hook=_reject_duplicate_keys
            )
        except (UnicodeError, ValueError, RecursionError):
            self._fail("final_output_malformed")
            return
        if not isinstance(event, dict) or not isinstance(event.get("type"), str):
            self._fail("final_output_malformed")
            return
        event_type = event["type"]
        if event_type in ("error", "turn.failed"):
            self.saw_error_event = True
            return
        if event_type != "item.completed":
            return
        item = event.get("item")
        if not isinstance(item, dict) or not isinstance(item.get("type"), str):
            self._fail("final_output_malformed")
            return
        # Tool, exec, reasoning, and user items are valid native events but are
        # deliberately outside the answer trust boundary.
        if item["type"] != "agent_message":
            return
        text_value = item.get("text")
        if not isinstance(text_value, str) or not text_value:
            self._fail("final_output_malformed")
            return
        try:
            encoded = text_value.encode("utf-8")
        except UnicodeError:
            self._fail("final_output_malformed")
            return
        if len(encoded) > FINAL_OUTPUT_LIMIT:
            self._fail("final_output_oversized")
            return
        # Codex can complete more than one agent message during a turn.  Its
        # native stream is ordered, so the last completed one is the defined
        # final answer; earlier messages never escape this parser.
        self.final_output = encoded

    def finish(self) -> Tuple[Optional[bytes], Optional[str]]:
        if self.error is None and self.pending:
            line = bytes(self.pending)
            self.pending.clear()
            self._parse_line(line)
        if self.error is not None:
            return None, self.error
        if self.saw_error_event:
            return None, "final_output_error"
        if self.final_output is None:
            return None, "final_output_missing"
        return self.final_output, None


class StreamClassifier:
    """Incrementally finds a stable reason ID without retaining full output."""

    def __init__(self) -> None:
        self.window = ""
        self.reason_id = None  # type: Optional[str]
        self.lock = threading.Lock()

    def feed(self, chunk: bytes) -> None:
        if self.reason_id is not None:
            return
        text = chunk.decode("utf-8", "ignore")
        with self.lock:
            candidate = self.window + text
            for reason_id, pattern in FAILURE_PATTERNS:
                if pattern.search(candidate):
                    self.reason_id = reason_id
                    return
            self.window = candidate[-512:]


