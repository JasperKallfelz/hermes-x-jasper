# A POSIX target cannot safely own its own process group: its stable PID
# identity disappears when it exits even if descendants keep the PGID alive.
# This supervisor remains the group leader through fail-closed cleanup.
POSIX_PROCESS_SUPERVISOR_SOURCE = r'''import errno,os,select,signal,sys,time
FAIL=70
READY=b"R"
ACK=b"G"
CLEAN=b"C"
def clock():
 return time.clock_gettime(time.CLOCK_MONOTONIC)
def send(fd,payload,timeout):
 try:
  if timeout>0 and select.select([],[fd],[],timeout)[1]: return os.write(fd,payload)==len(payload)
 except OSError: pass
 return False
def stop_group():
 try: os.killpg(os.getpgrp(),signal.SIGKILL)
 except OSError: pass
 os._exit(FAIL)
def main(a):
 if os.name!="posix" or len(a)<5: return FAIL
 try: control=int(a[0],10); status_fd=int(a[1],10); launch_deadline=float(a[2]); hard_deadline=float(a[3]); remaining=launch_deadline-clock()
 except (AttributeError,TypeError,ValueError,OverflowError,OSError): return FAIL
 command=a[4:]
 if control<=2 or status_fd<=2 or control==status_fd or not command or launch_deadline!=launch_deadline or hard_deadline!=hard_deadline or hard_deadline<launch_deadline or remaining<=0 or remaining>10.0: return FAIL
 try:
  if os.getsid(0)!=os.getpid() or os.getpgrp()!=os.getpid(): return FAIL
  os.set_inheritable(control,False); os.set_inheritable(status_fd,False)
  for sig in (signal.SIGHUP,signal.SIGINT,signal.SIGTERM): signal.signal(sig,signal.SIG_IGN)
  remaining=launch_deadline-clock()
  if remaining<=0 or not send(status_fd,READY,remaining): return FAIL
  remaining=launch_deadline-clock()
  if remaining<=0 or not select.select([control],[],[],remaining)[0]: return FAIL
  if os.read(control,2)!=ACK: return FAIL
  child=os.fork()
  if child==0:
   try:
    os.close(control)
    for sig in (signal.SIGHUP,signal.SIGINT,signal.SIGTERM): signal.signal(sig,signal.SIG_DFL)
    os.execvpe(command[0],command,os.environ)
   except OSError as error:
    send(status_fd,b"E %d\n"%(error.errno or errno.EIO),1.0)
    os._exit(127 if error.errno==errno.ENOENT else 126)
  while True:
   try: waited,child_status=os.waitpid(child,os.WNOHANG)
   except InterruptedError: waited=0
   except ChildProcessError: stop_group()
   if waited==child:
    if os.WIFEXITED(child_status): rc=os.WEXITSTATUS(child_status)
    elif os.WIFSIGNALED(child_status): rc=-os.WTERMSIG(child_status)
    else: stop_group()
    if not send(status_fd,b"D %d\n"%rc,max(0.0,hard_deadline-clock())): stop_group()
    break
   try:
    readable=select.select([control],[],[],0.01)[0]
    if readable:
     os.read(control,2)
     stop_group()
   except OSError: stop_group()
  while True:
   try:
    remaining=hard_deadline-clock()
    if remaining<=0 or not select.select([control],[],[],remaining)[0]: stop_group()
    if os.read(control,2)==CLEAN: stop_group()
    stop_group()
   except OSError: stop_group()
 except OSError: stop_group()
if __name__=="__main__": raise SystemExit(main(sys.argv[1:]))
'''
