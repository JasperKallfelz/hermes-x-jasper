# Contextual patterns only. In particular, bare 401 and 429 values are not
# quota/auth evidence: they occur frequently in source code and test output.
FAILURE_PATTERNS = (
    (
        "quota_usage_limit",
        re.compile(
            r"\b(?:usage[_-]limit[_-](?:reached|exceeded)|"
            r"(?:claude(?: code)?|anthropic|subscription|account|plan)[^\r\n]{0,64}"
            r"usage[ -]?limit[ -]?(?:reached|exceeded))\b",
            re.I,
        ),
    ),
    ("quota_exhausted", re.compile(r"\bquota\b[^\r\n]{0,96}\b(?:exhausted|exceeded|depleted|reached)\b", re.I)),
    ("quota_insufficient", re.compile(r"\b(?:insufficient[_ -]?quota|credit balance[^\r\n]{0,64}(?:low|empty|exhausted)|billing[_ -]?limit)\b", re.I)),
    ("quota_rate_limit", re.compile(r"\b(?:rate[_ -]?limit|too many requests)\b[^\r\n]{0,96}\b(?:exceeded|reached|retry|requests?)\b", re.I)),
    ("auth_invalid_grant", re.compile(r"\binvalid[_ -]?grant\b", re.I)),
    (
        "auth_failed",
        re.compile(
            r"\b(?:oauth|api|access|refresh|bearer|account|credential)[^\r\n]{0,48}"
            r"(?:token[^\r\n]{0,32})?(?:authentication|authorization)[^\r\n]{0,32}"
            r"(?:failed|required|expired|invalid)\b",
            re.I,
        ),
    ),
    (
        "auth_login_required",
        re.compile(
            r"\b(?:invalid (?:api[ _-]?)?key|(?:api|access|refresh|oauth) token (?:has )?expired|"
            r"(?:claude(?: code)?|codex|openai|anthropic)[^\r\n]{0,48}(?:login|sign[ -]?in) required)\b",
            re.I,
        ),
    ),
    ("quota_wrapper_exhausted", re.compile(r"\babos? sind derzeit ausgesch", re.I)),
)


