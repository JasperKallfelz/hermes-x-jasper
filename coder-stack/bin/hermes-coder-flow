# Each of the two sequential vendor checks can spend up to four seconds in
# _stop_process_group after its auth timeout.  The outer flow must budget that
# bounded cleanup as well as a small scheduling margin or it can kill an
# otherwise well-behaved Doctor before the privacy-safe result is emitted.
DOCTOR_VENDOR_CLEANUP_SECONDS = 4.0
DOCTOR_GRACE_SECONDS = (2.0 * DOCTOR_VENDOR_CLEANUP_SECONDS) + 2.0
MAX_DOCTOR_RESULT_BYTES = 16 * 1024
# The runner may spend up to four seconds stopping a child process group and
# then two seconds joining each of its two output pumps before it can emit the
# shutdown acknowledgement. Keep a small scheduling margin above that bounded
# eight-second path so a clean handoff does not spuriously become a forced kill.
RUNNER_ACK_GRACE_SECONDS = 10.0
HANDOFF_MAX_FRAME_BYTES = 1024
