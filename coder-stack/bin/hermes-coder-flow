# Stage instructions add only fixed text and bounded review findings to the
# original prompt. Keep a separate ceiling so a prompt accepted during
# preflight cannot fail merely because the flow wrapped it safely.
MAX_STAGE_PROMPT_BYTES = MAX_PROMPT_BYTES + 64 * 1024

