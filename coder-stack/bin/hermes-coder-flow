#!/usr/bin/env python3
"""Inline, synchronous subagent orchestration layered on bin/hermes-coder.

Every model execution in this file goes through the hermes-coder CLI. There is
no direct vendor API call, no parallel writer, and no automatic commit, merge,
push, or worktree cleanup: partial work is always preserved for manual review.
"""
