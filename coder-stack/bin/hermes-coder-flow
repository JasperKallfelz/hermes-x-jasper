# Repo-local config can make a plain `git` call execute attacker-chosen code
# (core.fsmonitor, core.hooksPath, and the hooks a checkout fires). Stripping
# GIT_* from the environment does not cover any of that, so every Git call this
# orchestrator makes disables both mechanisms for the duration of the call.
GIT_HARDENED_CONFIG = (
    "-c", "core.hooksPath=/dev/null",
    "-c", "core.fsmonitor=",
)
# Control surfaces under the common Git directory that a read-only stage must
# not be able to touch invisibly.
GIT_HOOKS_DIRNAME = "hooks"
