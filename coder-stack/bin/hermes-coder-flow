# Deterministic overrides are evaluated before any classifier subagent runs, so
# security and high-impact work cannot be talked down into a cheap lane.
SECURITY_PATTERNS = (
    re.compile(r"\b(?:security|secure coding|threat model|trust boundary)\b", re.I),
    re.compile(r"\b(?:auth|authn|authz|authentication|authorization)\b", re.I),
    re.compile(r"\b(?:oauth|oidc|saml|jwt|rbac|login|logout|single sign[ -]?on|mfa|2fa)\b", re.I),
    re.compile(r"\b(?:credential|password|passphrase|secret|api[ _-]?key|private[ _-]?key|token)s?\b", re.I),
    re.compile(r"\b(?:crypto|cryptography|cryptographic|encrypt|encryption|decrypt|tls|ssl|hmac|signature)\b", re.I),
    re.compile(r"\b(?:vulnerability|vulnerabilities|exploit|injection|xss|csrf|ssrf|sandbox escape)\b", re.I),
    re.compile(r"\bcve-\d{4}-\d{4,}\b", re.I),
    re.compile(r"\b(?:permission|privilege|access control|sanitize|sanitization|untrusted input)\b", re.I),
)
HIGH_IMPACT_PATTERNS = (
    re.compile(r"\b(?:migration|migrate|schema change|backfill)\b", re.I),
    re.compile(r"\b(?:concurrency|concurrent|race condition|deadlock|thread[ -]?safe|thread[ -]?safety)\b", re.I),
    re.compile(r"\b(?:production|deploy|deployment|rollback|payment|billing|invoice)\b", re.I),
    re.compile(r"\b(?:data loss|corruption|irreversible|destructive)\b", re.I),
    re.compile(r"\b(?:wire format|public api|breaking change)\b", re.I),
)

CLASSIFY_PROMPT = """You are a read-only task classifier. Do not modify, create, or delete any file.

Choose the smallest capability lane that can complete the task below correctly.

The implementation worktree will start at Git commit {start_sha}. If repository
inspection is useful, use read-only Git commands against that exact commit; do
not assume the source checkout's current files are the selected start tree.

  fast      trivial, local, mechanical edits
  normal    ordinary single-component feature or bug fix
  complex   multi-component work, subtle logic, tricky invariants, broad refactors
  frontier  research-grade or unusually hard design work
  security  authentication, authorization, secrets, cryptography, or exploitable surfaces

Inspect the repository if that helps you judge scope.

Reply with exactly one block in the format below and write nothing after it. The
block must contain a single JSON object with a "lane" key whose value is one of
fast, normal, complex, frontier, or security, and a "reason_code" key whose value
is a short snake_case token.

<<<{marker}
{{"lane": "REPLACE_WITH_A_LANE", "reason_code": "replace_me"}}
{marker}>>>

Task to classify:
{prompt}
"""

REVIEW_PROMPT = """You are an independent read-only reviewer. Do not modify, create, or delete any file.

Another model implemented the task below in this worktree. The work is uncommitted.
Inspect it with read-only commands, for example:

  git status --porcelain=v1 --untracked-files=all
  git diff {start_sha} --

New files may still be untracked; read them directly. Judge only whether the
implementation correctly and safely accomplishes the task.

Reply with exactly one block in the format below and write nothing after it. The
block must contain a single JSON object with exactly these keys:

  verdict   "pass" or "fail"
  severity  "none", "low", "medium", "high", or "critical" -- the overall severity
  summary   one short paragraph, at most {summary_limit} characters
  findings  a list of at most {findings_limit} objects, each with exactly the keys
            "severity", "title", and "detail"

Use verdict "fail" whenever the work is incorrect, unsafe, or incomplete, and
include at least one finding explaining why. Use verdict "pass" only when no
finding is of "medium", "high", or "critical" severity. The declared overall
severity must exactly match the highest finding, or be "none" when there are no
findings.

<<<{marker}
{{"verdict": "REPLACE_WITH_PASS_OR_FAIL", "severity": "high", "summary": "replace me", "findings": [{{"severity": "high", "title": "replace me", "detail": "replace me"}}]}}
{marker}>>>

Task that was implemented:
{prompt}
"""

